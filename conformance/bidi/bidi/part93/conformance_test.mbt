    input: "\u{202A}\u{200B}\u{0009}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, -1],
    expected_reorder: [2],
  },
  {
    number: 46997,
    input: "\u{202A}\u{200B}\u{0009}\u{202D}",
    direction: None,
    expected_levels: [-1, -1, 0, -1],
    expected_reorder: [2],
  },
  {
    number: 46998,
    input: "\u{202A}\u{200B}\u{0009}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, -1],
    expected_reorder: [2],
  },
  {
    number: 46999,
    input: "\u{202A}\u{200B}\u{0009}\u{202B}",
    direction: None,
    expected_levels: [-1, -1, 0, -1],
    expected_reorder: [2],
  },
]

///|
test "BidiTest.txt part 93" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
