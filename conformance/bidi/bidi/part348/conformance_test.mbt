    number: 174492,
    input: "\u{202E}\u{2067}\u{200B}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174493,
    input: "\u{202E}\u{2067}\u{200B}\u{2069}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174494,
    input: "\u{202E}\u{2067}\u{200B}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174495,
    input: "\u{202E}\u{2068}\u{202A}\u{000A}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174496,
    input: "\u{202E}\u{2068}\u{202A}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174497,
    input: "\u{202E}\u{2068}\u{202A}\u{0009}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174498,
    input: "\u{202E}\u{2068}\u{202A}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174499,
    input: "\u{202E}\u{2068}\u{202A}\u{0020}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 348" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
