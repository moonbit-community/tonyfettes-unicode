    input: "\u{200B}\u{0061}\u{202A}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 44492,
    input: "\u{200B}\u{0061}\u{202D}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 44493,
    input: "\u{200B}\u{0061}\u{202D}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 44494,
    input: "\u{200B}\u{0061}\u{202D}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 44495,
    input: "\u{200B}\u{0061}\u{202D}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 44496,
    input: "\u{200B}\u{0061}\u{202D}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 44497,
    input: "\u{200B}\u{0061}\u{202D}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 44498,
    input: "\u{200B}\u{0061}\u{202B}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 44499,
    input: "\u{200B}\u{0061}\u{202B}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
]

///|
test "BidiTest.txt part 88" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
