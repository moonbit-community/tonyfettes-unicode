    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18991,
    input: "\u{0009}\u{202A}\u{202C}\u{202B}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18992,
    input: "\u{0009}\u{202A}\u{202C}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18993,
    input: "\u{0009}\u{202A}\u{202C}\u{202E}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18994,
    input: "\u{0009}\u{202A}\u{202C}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18995,
    input: "\u{0009}\u{202A}\u{202C}\u{202C}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18996,
    input: "\u{0009}\u{202A}\u{202C}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18997,
    input: "\u{0009}\u{202A}\u{202C}\u{200B}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18998,
    input: "\u{0009}\u{202A}\u{202C}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18999,
    input: "\u{0009}\u{202A}\u{200B}\u{202A}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
]

///|
test "BidiTest.txt part 37" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
