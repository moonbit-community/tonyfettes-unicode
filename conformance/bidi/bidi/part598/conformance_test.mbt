  {
    number: 299488,
    input: "\u{0024}\u{2069}\u{202A}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 2],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 299489,
    input: "\u{0024}\u{2069}\u{202A}\u{002B}",
    direction: None,
    expected_levels: [0, 0, -1, 2],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 299490,
    input: "\u{0024}\u{2069}\u{202A}\u{002B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 2],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 299491,
    input: "\u{0024}\u{2069}\u{202A}\u{0024}",
    direction: None,
    expected_levels: [0, 0, -1, 2],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 299492,
    input: "\u{0024}\u{2069}\u{202A}\u{0024}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 2],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 299493,
    input: "\u{0024}\u{2069}\u{202A}\u{002C}",
    direction: None,
    expected_levels: [0, 0, -1, 2],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 299494,
    input: "\u{0024}\u{2069}\u{202A}\u{002C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 2],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 299495,
    input: "\u{0024}\u{2069}\u{202A}\u{0300}",
    direction: None,
    expected_levels: [0, 0, -1, 2],
    expected_reorder: [0, 1, 3],
  },
