    expected_reorder: [1, 2, 3],
  },
  {
    number: 485489,
    input: "\u{202C}\u{0024}\u{0030}\u{0020}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
