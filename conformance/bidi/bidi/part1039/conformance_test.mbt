    input: "\u{202C}\u{0627}\u{0660}\u{0660}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 2, 2],
    expected_reorder: [2, 3, 1],
  },
  {
    number: 519985,
    input: "\u{202C}\u{0627}\u{0660}\u{0660}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, 2, 2],
    expected_reorder: [2, 3, 1],
  },
  {
