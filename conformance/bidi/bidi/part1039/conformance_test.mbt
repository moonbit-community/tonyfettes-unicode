    expected_levels: [-1, 1, 2, 2],
    expected_reorder: [2, 3, 1],
  },
  {
    number: 519990,
    input: "\u{202C}\u{002B}\u{0061}\u{0030}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, 2, 2],
    expected_reorder: [2, 3, 1],
  },
  {
    number: 519991,
    input: "\u{202C}\u{002B}\u{0061}\u{0660}",
