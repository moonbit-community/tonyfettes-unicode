    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 226493,
    input: "\u{202C}\u{200B}\u{0009}\u{000A}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 226494,
    input: "\u{202C}\u{200B}\u{0009}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 226495,
    input: "\u{202C}\u{200B}\u{0009}\u{0009}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 226496,
    input: "\u{202C}\u{200B}\u{0009}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 226497,
    input: "\u{202C}\u{200B}\u{0009}\u{0020}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 226498,
    input: "\u{202C}\u{200B}\u{0009}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 226499,
    input: "\u{202C}\u{200B}\u{0009}\u{0021}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
]

///|
test "BidiTest.txt part 452" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
