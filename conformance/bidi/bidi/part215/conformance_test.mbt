    number: 107988,
    input: "\u{0020}\u{200B}\u{202A}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 107989,
    input: "\u{0020}\u{200B}\u{202A}\u{0009}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 107990,
    input: "\u{0020}\u{200B}\u{202A}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 107991,
    input: "\u{0020}\u{200B}\u{202A}\u{0020}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 107992,
    input: "\u{0020}\u{200B}\u{202A}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 107993,
    input: "\u{0020}\u{200B}\u{202A}\u{2066}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 107994,
    input: "\u{0020}\u{200B}\u{202A}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 107995,
    input: "\u{0020}\u{200B}\u{202A}\u{2067}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
