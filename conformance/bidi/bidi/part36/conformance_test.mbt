    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18491,
    input: "\u{002C}\u{200B}\u{202C}\u{202C}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18492,
    input: "\u{002C}\u{200B}\u{202C}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18493,
    input: "\u{002C}\u{200B}\u{202C}\u{200B}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18494,
    input: "\u{002C}\u{200B}\u{202C}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18495,
    input: "\u{002C}\u{200B}\u{200B}\u{202A}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18496,
    input: "\u{002C}\u{200B}\u{200B}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18497,
    input: "\u{002C}\u{200B}\u{200B}\u{202D}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18498,
    input: "\u{002C}\u{200B}\u{200B}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 18499,
    input: "\u{002C}\u{200B}\u{200B}\u{202B}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
]

///|
test "BidiTest.txt part 36" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
