    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 200984,
    input: "\u{202A}\u{002B}\u{0300}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 200985,
    input: "\u{202A}\u{002B}\u{0300}\u{202B}",
    direction: None,
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
