    expected_reorder: [1, 3],
  },
  {
    number: 172988,
    input: "\u{202A}\u{2068}\u{202B}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172989,
    input: "\u{202A}\u{2068}\u{202B}\u{2069}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172990,
    input: "\u{202A}\u{2068}\u{202B}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172991,
    input: "\u{202A}\u{2068}\u{202E}\u{000A}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172992,
    input: "\u{202A}\u{2068}\u{202E}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172993,
    input: "\u{202A}\u{2068}\u{202E}\u{0009}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172994,
    input: "\u{202A}\u{2068}\u{202E}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172995,
    input: "\u{202A}\u{2068}\u{202E}\u{0020}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172996,
    input: "\u{202A}\u{2068}\u{202E}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172997,
    input: "\u{202A}\u{2068}\u{202E}\u{2066}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172998,
    input: "\u{202A}\u{2068}\u{202E}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 172999,
    input: "\u{202A}\u{2068}\u{202E}\u{2067}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 345" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
