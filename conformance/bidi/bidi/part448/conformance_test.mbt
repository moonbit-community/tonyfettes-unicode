    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224493,
    input: "\u{202B}\u{202E}\u{2069}\u{000A}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224494,
    input: "\u{202B}\u{202E}\u{2069}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224495,
    input: "\u{202B}\u{202E}\u{2069}\u{0009}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224496,
    input: "\u{202B}\u{202E}\u{2069}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224497,
    input: "\u{202B}\u{202E}\u{2069}\u{0020}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224498,
    input: "\u{202B}\u{202E}\u{2069}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224499,
    input: "\u{202B}\u{202E}\u{2069}\u{2066}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
]

///|
test "BidiTest.txt part 448" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
