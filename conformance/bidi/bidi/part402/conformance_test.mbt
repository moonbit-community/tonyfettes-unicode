    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201488,
    input: "\u{202A}\u{0020}\u{0300}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201489,
    input: "\u{202A}\u{0020}\u{0300}\u{202B}",
    direction: None,
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201490,
    input: "\u{202A}\u{0020}\u{0300}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201491,
    input: "\u{202A}\u{0020}\u{0300}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201492,
    input: "\u{202A}\u{0020}\u{0300}\u{202E}",
    direction: None,
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201493,
    input: "\u{202A}\u{0020}\u{0300}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201494,
    input: "\u{202A}\u{0020}\u{0300}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201495,
    input: "\u{202A}\u{0020}\u{0300}\u{202C}",
    direction: None,
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201496,
    input: "\u{202A}\u{0020}\u{0300}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201497,
    input: "\u{202A}\u{0020}\u{0300}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201498,
    input: "\u{202A}\u{0020}\u{0300}\u{200B}",
    direction: None,
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 201499,
    input: "\u{202A}\u{0020}\u{0300}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 2, -1],
    expected_reorder: [1, 2],
  },
]

///|
test "BidiTest.txt part 402" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
