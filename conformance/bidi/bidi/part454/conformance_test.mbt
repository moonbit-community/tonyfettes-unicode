  {
    number: 227494,
    input: "\u{200B}\u{200B}\u{0020}\u{002B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 227495,
    input: "\u{200B}\u{200B}\u{0020}\u{0024}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 227496,
    input: "\u{200B}\u{200B}\u{0020}\u{0024}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 227497,
    input: "\u{200B}\u{200B}\u{0020}\u{002C}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 227498,
    input: "\u{200B}\u{200B}\u{0020}\u{002C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 227499,
    input: "\u{200B}\u{200B}\u{0020}\u{0300}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
]

///|
test "BidiTest.txt part 454" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
