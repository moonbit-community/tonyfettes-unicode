    input: "\u{202E}\u{202A}\u{2069}\u{2067}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224992,
    input: "\u{202E}\u{202A}\u{2069}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224993,
    input: "\u{202E}\u{202A}\u{2069}\u{2068}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224994,
    input: "\u{202E}\u{202A}\u{2069}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224995,
    input: "\u{202E}\u{202A}\u{2069}\u{2069}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224996,
    input: "\u{202E}\u{202A}\u{2069}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224997,
    input: "\u{202E}\u{202D}\u{0009}\u{000A}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224998,
    input: "\u{202E}\u{202D}\u{0009}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 224999,
    input: "\u{202E}\u{202D}\u{0009}\u{0009}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
]

///|
test "BidiTest.txt part 449" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
