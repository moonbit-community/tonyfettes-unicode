  {
    number: 100491,
    input: "\u{0021}\u{202A}\u{0030}\u{202C}",
    direction: None,
    expected_levels: [0, -1, 2, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 100492,
    input: "\u{0021}\u{202A}\u{0030}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 2, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 100493,
    input: "\u{0021}\u{202A}\u{0030}\u{200B}",
    direction: None,
    expected_levels: [0, -1, 2, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 100494,
    input: "\u{0021}\u{202A}\u{0030}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 2, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 100495,
    input: "\u{0021}\u{202A}\u{002B}\u{202A}",
    direction: None,
    expected_levels: [0, -1, 2, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 100496,
    input: "\u{0021}\u{202A}\u{002B}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 2, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 100497,
    input: "\u{0021}\u{202A}\u{002B}\u{202D}",
    direction: None,
    expected_levels: [0, -1, 2, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 100498,
    input: "\u{0021}\u{202A}\u{002B}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 2, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 100499,
    input: "\u{0021}\u{202A}\u{002B}\u{202B}",
    direction: None,
    expected_levels: [0, -1, 2, -1],
    expected_reorder: [0, 2],
  },
]

///|
test "BidiTest.txt part 200" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
