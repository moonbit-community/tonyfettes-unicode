    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 223492,
    input: "\u{202D}\u{202A}\u{2068}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 223493,
    input: "\u{202D}\u{202A}\u{2068}\u{2067}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 223494,
    input: "\u{202D}\u{202A}\u{2068}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 223495,
    input: "\u{202D}\u{202A}\u{2068}\u{2068}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 223496,
    input: "\u{202D}\u{202A}\u{2068}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 223497,
    input: "\u{202D}\u{202A}\u{2068}\u{2069}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 223498,
    input: "\u{202D}\u{202A}\u{2068}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 223499,
    input: "\u{202D}\u{202A}\u{2069}\u{000A}",
    direction: None,
    expected_levels: [-1, -1, 0, 0],
    expected_reorder: [2, 3],
  },
]

///|
test "BidiTest.txt part 446" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
