    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 37990,
    input: "\u{202D}\u{2067}\u{202E}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 37991,
    input: "\u{202D}\u{2067}\u{202C}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 37992,
    input: "\u{202D}\u{2067}\u{202C}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 37993,
    input: "\u{202D}\u{2067}\u{202C}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 37994,
    input: "\u{202D}\u{2067}\u{202C}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 37995,
    input: "\u{202D}\u{2067}\u{202C}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 37996,
    input: "\u{202D}\u{2067}\u{202C}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 37997,
    input: "\u{202D}\u{2067}\u{200B}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 37998,
    input: "\u{202D}\u{2067}\u{200B}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 37999,
    input: "\u{202D}\u{2067}\u{200B}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, -1],
    expected_reorder: [1],
  },
]

///|
test "BidiTest.txt part 75" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
