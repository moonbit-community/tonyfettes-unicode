    input: "\u{0020}\u{202D}\u{202C}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 19497,
    input: "\u{0020}\u{202D}\u{202C}\u{202E}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 19498,
    input: "\u{0020}\u{202D}\u{202C}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 19499,
    input: "\u{0020}\u{202D}\u{202C}\u{202C}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
]

///|
test "BidiTest.txt part 38" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
