    number: 498488,
    input: "\u{202C}\u{2069}\u{0660}\u{0660}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 498489,
    input: "\u{202C}\u{2069}\u{0660}\u{0300}",
    direction: None,
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 498490,
    input: "\u{202C}\u{2069}\u{0660}\u{0300}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 498491,
    input: "\u{200B}\u{0061}\u{0660}\u{0660}",
    direction: None,
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 498492,
    input: "\u{200B}\u{0061}\u{0660}\u{0660}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 498493,
    input: "\u{200B}\u{0061}\u{0660}\u{0300}",
    direction: None,
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 498494,
    input: "\u{200B}\u{0061}\u{0660}\u{0300}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 498495,
    input: "\u{200B}\u{0030}\u{0660}\u{0660}",
    direction: None,
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 498496,
    input: "\u{200B}\u{0030}\u{0660}\u{0660}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
