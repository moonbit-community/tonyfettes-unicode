    expected_reorder: [1],
  },
  {
    number: 498,
    input: "\u{202B}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0],
    expected_reorder: [1],
  },
  {
    number: 499,
    input: "\u{202B}\u{2066}",
    direction: None,
    expected_levels: [-1, 0],
    expected_reorder: [1],
  },
]

///|
test "BidiTest.txt part 0" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
