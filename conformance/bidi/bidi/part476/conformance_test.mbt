    input: "\u{202E}\u{202C}\u{0061}\u{0061}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
  {
    number: 238490,
    input: "\u{202E}\u{202C}\u{0061}\u{0030}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
  {
    number: 238491,
    input: "\u{202E}\u{202C}\u{0061}\u{0660}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
  {
    number: 238492,
    input: "\u{202E}\u{202C}\u{0061}\u{0300}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
  {
    number: 238493,
    input: "\u{202E}\u{202C}\u{0030}\u{0061}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
  {
    number: 238494,
    input: "\u{202E}\u{202C}\u{0030}\u{0030}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
  {
    number: 238495,
    input: "\u{202E}\u{202C}\u{0030}\u{0024}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
  {
    number: 238496,
    input: "\u{202E}\u{202C}\u{0030}\u{0660}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
  {
    number: 238497,
    input: "\u{202E}\u{202C}\u{0030}\u{0300}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
  {
    number: 238498,
    input: "\u{202E}\u{202C}\u{0024}\u{0030}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
  {
    number: 238499,
    input: "\u{202E}\u{202C}\u{0660}\u{0061}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, 2],
    expected_reorder: [2, 3],
  },
]

///|
test "BidiTest.txt part 476" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
