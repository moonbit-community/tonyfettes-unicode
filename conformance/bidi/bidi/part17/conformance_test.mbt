    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8994,
    input: "\u{202B}\u{202D}\u{202E}\u{202E}",
    direction: None,
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8995,
    input: "\u{202B}\u{202D}\u{202E}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8996,
    input: "\u{202B}\u{202D}\u{202E}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8997,
    input: "\u{202B}\u{202D}\u{202E}\u{202C}",
    direction: None,
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8998,
    input: "\u{202B}\u{202D}\u{202E}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8999,
    input: "\u{202B}\u{202D}\u{202E}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
]

///|
test "BidiTest.txt part 17" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
