    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 167992,
    input: "\u{202C}\u{0024}\u{2068}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 167993,
    input: "\u{202C}\u{0024}\u{2068}\u{202D}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 167994,
    input: "\u{202C}\u{0024}\u{2068}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 167995,
    input: "\u{202C}\u{0024}\u{2068}\u{202B}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 167996,
    input: "\u{202C}\u{0024}\u{2068}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 167997,
    input: "\u{202C}\u{0024}\u{2068}\u{202E}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 167998,
    input: "\u{202C}\u{0024}\u{2068}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 167999,
    input: "\u{202C}\u{0024}\u{2068}\u{202C}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
]

///|
test "BidiTest.txt part 335" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
