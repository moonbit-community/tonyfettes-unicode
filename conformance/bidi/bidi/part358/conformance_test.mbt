    expected_levels: [-1, 0, -1, 3],
    expected_reorder: [1, 3],
  },
  {
    number: 179491,
    input: "\u{202E}\u{0009}\u{202B}\u{0300}",
    direction: None,
    expected_levels: [-1, 0, -1, 3],
    expected_reorder: [1, 3],
  },
  {
    number: 179492,
    input: "\u{202E}\u{0009}\u{202B}\u{0300}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 3],
    expected_reorder: [1, 3],
  },
  {
    number: 179493,
    input: "\u{202E}\u{0009}\u{202B}\u{0021}",
    direction: None,
    expected_levels: [-1, 0, -1, 3],
    expected_reorder: [1, 3],
  },
  {
    number: 179494,
    input: "\u{202E}\u{0009}\u{202B}\u{0021}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 3],
    expected_reorder: [1, 3],
  },
  {
    number: 179495,
    input: "\u{202E}\u{0009}\u{202E}\u{0061}",
    direction: None,
    expected_levels: [-1, 0, -1, 3],
    expected_reorder: [1, 3],
  },
  {
    number: 179496,
    input: "\u{202E}\u{0009}\u{202E}\u{0061}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 3],
    expected_reorder: [1, 3],
  },
  {
    number: 179497,
    input: "\u{202E}\u{0009}\u{202E}\u{05D0}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 3],
    expected_reorder: [1, 3],
  },
  {
    number: 179498,
    input: "\u{202E}\u{0009}\u{202E}\u{0627}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 3],
    expected_reorder: [1, 3],
  },
  {
    number: 179499,
    input: "\u{202E}\u{0009}\u{202E}\u{0030}",
    direction: None,
    expected_levels: [-1, 0, -1, 3],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 358" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
