    input: "\u{202D}\u{0009}\u{0061}\u{002C}",
    direction: None,
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 497984,
    input: "\u{202D}\u{0009}\u{0061}\u{002C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 497985,
    input: "\u{202D}\u{0009}\u{0061}\u{0300}",
    direction: None,
    expected_levels: [-1, 0, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
