    input: "\u{0021}\u{202A}\u{0009}\u{2069}",
    direction: None,
    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 336488,
    input: "\u{0021}\u{202A}\u{0009}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 336489,
    input: "\u{0021}\u{202A}\u{0020}\u{000A}",
    direction: None,
    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 336490,
    input: "\u{0021}\u{202A}\u{0020}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
