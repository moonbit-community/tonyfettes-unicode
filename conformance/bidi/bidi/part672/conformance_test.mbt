    input: "\u{0021}\u{202A}\u{0020}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 336493,
    input: "\u{0021}\u{202A}\u{0020}\u{0020}",
    direction: None,
    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 336494,
    input: "\u{0021}\u{202A}\u{0020}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 336495,
    input: "\u{0021}\u{202A}\u{0020}\u{2066}",
    direction: None,
    expected_levels: [0, -1, 0, 0],
