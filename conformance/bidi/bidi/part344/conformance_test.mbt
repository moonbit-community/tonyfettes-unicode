    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 3, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 172488,
    input: "\u{202A}\u{0009}\u{0627}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 3, -1],
    expected_reorder: [1, 2],
  },
  {
