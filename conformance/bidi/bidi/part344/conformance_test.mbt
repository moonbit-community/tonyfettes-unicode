    input: "\u{202C}\u{2066}\u{05D0}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 3, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 172495,
    input: "\u{202C}\u{2066}\u{05D0}\u{202B}",
    direction: None,
    expected_levels: [-1, 0, 3, -1],
