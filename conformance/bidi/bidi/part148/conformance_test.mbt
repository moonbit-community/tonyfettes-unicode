    number: 74489,
    input: "\u{002B}\u{0061}\u{202C}\u{200B}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 74490,
    input: "\u{002B}\u{0061}\u{202C}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 74491,
    input: "\u{002B}\u{0061}\u{200B}\u{202A}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 74492,
    input: "\u{002B}\u{0061}\u{200B}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 74493,
    input: "\u{002B}\u{0061}\u{200B}\u{202D}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 74494,
    input: "\u{002B}\u{0061}\u{200B}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 74495,
    input: "\u{002B}\u{0061}\u{200B}\u{202B}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 74496,
    input: "\u{002B}\u{0061}\u{200B}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 74497,
    input: "\u{002B}\u{0061}\u{200B}\u{202E}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
