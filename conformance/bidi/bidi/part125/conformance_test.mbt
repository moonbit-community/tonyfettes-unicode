    input: "\u{202D}\u{200B}\u{200B}\u{0030}",
    direction: None,
    expected_levels: [-1, -1, -1, 2],
    expected_reorder: [3],
  },
  {
    number: 62984,
    input: "\u{202D}\u{200B}\u{200B}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, 2],
    expected_reorder: [3],
  },
  {
