    expected_reorder: [1, 3],
  },
  {
    number: 173490,
    input: "\u{202D}\u{2068}\u{202D}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 173491,
    input: "\u{202D}\u{2068}\u{202D}\u{2068}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 173492,
    input: "\u{202D}\u{2068}\u{202D}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 173493,
    input: "\u{202D}\u{2068}\u{202D}\u{2069}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 173494,
    input: "\u{202D}\u{2068}\u{202D}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 173495,
    input: "\u{202D}\u{2068}\u{202B}\u{000A}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 173496,
    input: "\u{202D}\u{2068}\u{202B}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 173497,
    input: "\u{202D}\u{2068}\u{202B}\u{0009}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 173498,
    input: "\u{202D}\u{2068}\u{202B}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 173499,
    input: "\u{202D}\u{2068}\u{202B}\u{0020}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 346" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
