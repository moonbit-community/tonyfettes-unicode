    input: "\u{202C}\u{0061}\u{200B}\u{0627}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 1],
    expected_reorder: [1, 3],
  },
  {
    number: 177491,
    input: "\u{202C}\u{0030}\u{202B}\u{05D0}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 1],
    expected_reorder: [1, 3],
  },
  {
    number: 177492,
    input: "\u{202C}\u{0030}\u{202B}\u{0627}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 1],
    expected_reorder: [1, 3],
  },
  {
    number: 177493,
    input: "\u{202C}\u{0030}\u{202B}\u{002B}",
    direction: None,
    expected_levels: [-1, 0, -1, 1],
    expected_reorder: [1, 3],
  },
  {
    number: 177494,
    input: "\u{202C}\u{0030}\u{202B}\u{002B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 1],
    expected_reorder: [1, 3],
  },
  {
    number: 177495,
    input: "\u{202C}\u{0030}\u{202B}\u{0024}",
    direction: None,
    expected_levels: [-1, 0, -1, 1],
    expected_reorder: [1, 3],
  },
  {
    number: 177496,
    input: "\u{202C}\u{0030}\u{202B}\u{0024}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 1],
    expected_reorder: [1, 3],
  },
  {
    number: 177497,
    input: "\u{202C}\u{0030}\u{202B}\u{002C}",
    direction: None,
    expected_levels: [-1, 0, -1, 1],
    expected_reorder: [1, 3],
  },
  {
    number: 177498,
    input: "\u{202C}\u{0030}\u{202B}\u{002C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 1],
    expected_reorder: [1, 3],
  },
  {
    number: 177499,
    input: "\u{202C}\u{0030}\u{202B}\u{0300}",
    direction: None,
    expected_levels: [-1, 0, -1, 1],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 354" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
