    number: 174989,
    input: "\u{202C}\u{002B}\u{200B}\u{0021}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174990,
    input: "\u{202C}\u{002B}\u{200B}\u{0021}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174991,
    input: "\u{202C}\u{002B}\u{200B}\u{2066}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174992,
    input: "\u{202C}\u{002B}\u{200B}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174993,
    input: "\u{202C}\u{002B}\u{200B}\u{2067}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174994,
    input: "\u{202C}\u{002B}\u{200B}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174995,
    input: "\u{202C}\u{002B}\u{200B}\u{2068}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174996,
    input: "\u{202C}\u{002B}\u{200B}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174997,
    input: "\u{202C}\u{002B}\u{200B}\u{2069}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174998,
    input: "\u{202C}\u{002B}\u{200B}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 174999,
    input: "\u{202C}\u{0024}\u{202A}\u{000A}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 349" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
