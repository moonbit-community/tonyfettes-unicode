    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178989,
    input: "\u{200B}\u{0024}\u{202A}\u{0030}",
    direction: None,
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178990,
    input: "\u{200B}\u{0024}\u{202A}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178991,
    input: "\u{200B}\u{0024}\u{202A}\u{002B}",
    direction: None,
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178992,
    input: "\u{200B}\u{0024}\u{202A}\u{002B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178993,
    input: "\u{200B}\u{0024}\u{202A}\u{0024}",
    direction: None,
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178994,
    input: "\u{200B}\u{0024}\u{202A}\u{0024}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178995,
    input: "\u{200B}\u{0024}\u{202A}\u{002C}",
    direction: None,
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178996,
    input: "\u{200B}\u{0024}\u{202A}\u{002C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178997,
    input: "\u{200B}\u{0024}\u{202A}\u{0300}",
    direction: None,
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178998,
    input: "\u{200B}\u{0024}\u{202A}\u{0300}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178999,
    input: "\u{200B}\u{0024}\u{202A}\u{0021}",
    direction: None,
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 357" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
