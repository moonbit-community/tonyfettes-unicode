    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 490493,
    input: "\u{200B}\u{0020}\u{0021}\u{2067}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 490494,
    input: "\u{200B}\u{0020}\u{0021}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 490495,
    input: "\u{200B}\u{0020}\u{0021}\u{2068}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 490496,
    input: "\u{200B}\u{0020}\u{0021}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 490497,
    input: "\u{200B}\u{0020}\u{0021}\u{2069}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 490498,
    input: "\u{200B}\u{0020}\u{0021}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 490499,
    input: "\u{200B}\u{0020}\u{2066}\u{000A}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
]

///|
test "BidiTest.txt part 980" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
