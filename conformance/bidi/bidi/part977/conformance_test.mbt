    number: 488989,
    input: "\u{200B}\u{0024}\u{0030}\u{0030}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 488990,
    input: "\u{200B}\u{0024}\u{0030}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 488991,
    input: "\u{200B}\u{0024}\u{0030}\u{002B}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 488992,
    input: "\u{200B}\u{0024}\u{0030}\u{002B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 488993,
    input: "\u{200B}\u{0024}\u{0030}\u{0024}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 488994,
    input: "\u{200B}\u{0024}\u{0030}\u{0024}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 488995,
    input: "\u{200B}\u{0024}\u{0030}\u{002C}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 488996,
    input: "\u{200B}\u{0024}\u{0030}\u{002C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 488997,
    input: "\u{200B}\u{0024}\u{0030}\u{0300}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 488998,
    input: "\u{200B}\u{0024}\u{0030}\u{0300}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 488999,
    input: "\u{200B}\u{0024}\u{0030}\u{000A}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
]

///|
test "BidiTest.txt part 977" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
