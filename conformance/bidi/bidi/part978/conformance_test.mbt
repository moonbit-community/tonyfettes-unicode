    input: "\u{200B}\u{002C}\u{0020}\u{0009}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 489492,
    input: "\u{200B}\u{002C}\u{0020}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 489493,
    input: "\u{200B}\u{002C}\u{0020}\u{0020}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 489494,
    input: "\u{200B}\u{002C}\u{0020}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 489495,
    input: "\u{200B}\u{002C}\u{0020}\u{0021}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 489496,
    input: "\u{200B}\u{002C}\u{0020}\u{0021}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 489497,
    input: "\u{200B}\u{002C}\u{0020}\u{2066}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 489498,
    input: "\u{200B}\u{002C}\u{0020}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 489499,
    input: "\u{200B}\u{002C}\u{0020}\u{2067}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
]

///|
test "BidiTest.txt part 978" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
