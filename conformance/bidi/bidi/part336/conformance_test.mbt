    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 168493,
    input: "\u{202C}\u{0020}\u{0061}\u{200B}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 168494,
    input: "\u{202C}\u{0020}\u{0061}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 168495,
    input: "\u{202C}\u{0020}\u{0030}\u{202A}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 168496,
    input: "\u{202C}\u{0020}\u{0030}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 168497,
    input: "\u{202C}\u{0020}\u{0030}\u{202D}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 168498,
    input: "\u{202C}\u{0020}\u{0030}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 168499,
    input: "\u{202C}\u{0020}\u{0030}\u{202B}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
]

///|
test "BidiTest.txt part 336" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
