    input: "\u{0021}\u{0020}\u{2067}\u{202E}",
    direction: None,
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 267490,
    input: "\u{0021}\u{0020}\u{2067}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 267491,
    input: "\u{0021}\u{0020}\u{2067}\u{202C}",
    direction: None,
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 267492,
    input: "\u{0021}\u{0020}\u{2067}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 267493,
    input: "\u{0021}\u{0020}\u{2067}\u{200B}",
    direction: None,
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 267494,
    input: "\u{0021}\u{0020}\u{2067}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 267495,
    input: "\u{0021}\u{0020}\u{2068}\u{202A}",
    direction: None,
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 267496,
    input: "\u{0021}\u{0020}\u{2068}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 267497,
    input: "\u{0021}\u{0020}\u{2068}\u{202D}",
    direction: None,
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
