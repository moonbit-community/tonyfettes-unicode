    input: "\u{202E}\u{202B}\u{0030}\u{2067}",
    direction: None,
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246989,
    input: "\u{202E}\u{202B}\u{0030}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246990,
    input: "\u{202E}\u{202B}\u{0030}\u{2068}",
    direction: None,
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246991,
    input: "\u{202E}\u{202B}\u{0030}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246992,
    input: "\u{202E}\u{202B}\u{0030}\u{2069}",
    direction: None,
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246993,
    input: "\u{202E}\u{202B}\u{0030}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246994,
    input: "\u{202E}\u{202B}\u{0660}\u{000A}",
    direction: None,
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246995,
    input: "\u{202E}\u{202B}\u{0660}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246996,
    input: "\u{202E}\u{202B}\u{0660}\u{0009}",
    direction: None,
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246997,
    input: "\u{202E}\u{202B}\u{0660}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246998,
    input: "\u{202E}\u{202B}\u{0660}\u{0020}",
    direction: None,
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 246999,
    input: "\u{202E}\u{202B}\u{0660}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 4, 0],
    expected_reorder: [2, 3],
  },
]

///|
test "BidiTest.txt part 493" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
