    input: "\u{202A}\u{0021}\u{202C}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 42991,
    input: "\u{202A}\u{0021}\u{202C}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 42992,
    input: "\u{202A}\u{0021}\u{200B}\u{202A}",
    direction: None,
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 42993,
    input: "\u{202A}\u{0021}\u{200B}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 42994,
    input: "\u{202A}\u{0021}\u{200B}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 42995,
    input: "\u{202A}\u{0021}\u{200B}\u{202D}",
    direction: None,
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 42996,
    input: "\u{202A}\u{0021}\u{200B}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 42997,
    input: "\u{202A}\u{0021}\u{200B}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 42998,
    input: "\u{202A}\u{0021}\u{200B}\u{202B}",
    direction: None,
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 42999,
    input: "\u{202A}\u{0021}\u{200B}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, -1],
    expected_reorder: [1],
  },
]

///|
test "BidiTest.txt part 85" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
