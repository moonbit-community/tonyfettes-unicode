  {
    number: 169990,
    input: "\u{200B}\u{0300}\u{0024}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169991,
    input: "\u{200B}\u{0300}\u{0024}\u{202C}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169992,
    input: "\u{200B}\u{0300}\u{0024}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169993,
    input: "\u{200B}\u{0300}\u{0024}\u{200B}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169994,
    input: "\u{200B}\u{0300}\u{0024}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169995,
    input: "\u{200B}\u{0300}\u{002C}\u{202A}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169996,
    input: "\u{200B}\u{0300}\u{002C}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169997,
    input: "\u{200B}\u{0300}\u{002C}\u{202D}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169998,
    input: "\u{200B}\u{0300}\u{002C}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169999,
    input: "\u{200B}\u{0300}\u{002C}\u{202B}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
]

///|
test "BidiTest.txt part 339" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
