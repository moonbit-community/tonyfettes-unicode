    direction: None,
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
  {
    number: 55990,
    input: "\u{202D}\u{202D}\u{0021}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
  {
    number: 55991,
    input: "\u{202D}\u{202D}\u{0021}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
  {
    number: 55992,
    input: "\u{202D}\u{202D}\u{0021}\u{200B}",
    direction: None,
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
  {
    number: 55993,
    input: "\u{202D}\u{202D}\u{0021}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
  {
    number: 55994,
    input: "\u{202D}\u{202D}\u{0021}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
  {
    number: 55995,
    input: "\u{202D}\u{202B}\u{0061}\u{202A}",
    direction: None,
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
  {
    number: 55996,
    input: "\u{202D}\u{202B}\u{0061}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
  {
    number: 55997,
    input: "\u{202D}\u{202B}\u{0061}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
  {
    number: 55998,
    input: "\u{202D}\u{202B}\u{0061}\u{202D}",
    direction: None,
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
  {
    number: 55999,
    input: "\u{202D}\u{202B}\u{0061}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 4, -1],
    expected_reorder: [2],
  },
]

///|
test "BidiTest.txt part 111" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
