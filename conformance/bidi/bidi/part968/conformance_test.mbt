    input: "\u{202C}\u{0061}\u{0061}\u{002C}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484488,
    input: "\u{202C}\u{0061}\u{0061}\u{002C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484489,
    input: "\u{202C}\u{0061}\u{0061}\u{0300}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484490,
    input: "\u{202C}\u{0061}\u{0061}\u{0300}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484491,
    input: "\u{202C}\u{0061}\u{0061}\u{000A}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484492,
    input: "\u{202C}\u{0061}\u{0061}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484493,
    input: "\u{202C}\u{0061}\u{0061}\u{0009}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484494,
    input: "\u{202C}\u{0061}\u{0061}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484495,
    input: "\u{202C}\u{0061}\u{0061}\u{0020}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484496,
    input: "\u{202C}\u{0061}\u{0061}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484497,
    input: "\u{202C}\u{0061}\u{0061}\u{0021}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484498,
    input: "\u{202C}\u{0061}\u{0061}\u{0021}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 484499,
    input: "\u{202C}\u{0061}\u{0061}\u{2066}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
]

///|
test "BidiTest.txt part 968" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
