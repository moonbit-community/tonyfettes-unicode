    expected_base_level: 1,
    expected_levels: [1, 2, 1, 2, 1, 1, 1, 1],
    expected_reorder: [7, 6, 5, 4, 3, 2, 1, 0],
  },
  {
    number: 4487,
    input: "\u{0028}\u{0061}\u{0029}\u{0062}\u{0028}\u{2680}\u{0029}\u{2681}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 4488,
    input: "\u{0028}\u{0061}\u{0029}\u{0062}\u{0028}\u{2680}\u{0029}\u{2681}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 2, 1, 2, 1, 1, 1, 1],
    expected_reorder: [7, 6, 5, 4, 3, 2, 1, 0],
  },
  {
    number: 4489,
    input: "\u{0028}\u{0061}\u{0029}\u{0028}\u{0062}\u{2680}\u{0029}\u{2681}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 4490,
    input: "\u{0028}\u{0061}\u{0029}\u{0028}\u{0062}\u{2680}\u{0029}\u{2681}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 2, 1, 1, 2, 1, 1, 1],
    expected_reorder: [7, 6, 5, 4, 3, 2, 1, 0],
  },
  {
    number: 4491,
    input: "\u{0028}\u{0029}\u{0061}\u{0028}\u{0062}\u{2680}\u{0029}\u{2681}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 4492,
    input: "\u{0028}\u{0029}\u{0061}\u{0028}\u{0062}\u{2680}\u{0029}\u{2681}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 1, 2, 2, 2, 2, 2, 1],
    expected_reorder: [7, 2, 3, 4, 5, 6, 1, 0],
  },
  {
    number: 4493,
    input: "\u{0061}\u{0028}\u{0062}\u{2680}\u{0063}\u{0029}\u{0028}\u{0029}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 4494,
    input: "\u{0061}\u{0028}\u{0062}\u{2680}\u{0063}\u{0029}\u{0028}\u{0029}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [2, 2, 2, 2, 2, 2, 1, 1],
    expected_reorder: [7, 6, 0, 1, 2, 3, 4, 5],
  },
  {
    number: 4495,
    input: "\u{0061}\u{0028}\u{0062}\u{2680}\u{0029}\u{0063}\u{0028}\u{0029}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 4496,
    input: "\u{0061}\u{0028}\u{0062}\u{2680}\u{0029}\u{0063}\u{0028}\u{0029}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [2, 2, 2, 2, 2, 2, 1, 1],
    expected_reorder: [7, 6, 0, 1, 2, 3, 4, 5],
  },
  {
    number: 4497,
    input: "\u{0061}\u{0028}\u{0062}\u{2680}\u{0029}\u{0028}\u{0063}\u{0029}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 4498,
    input: "\u{0061}\u{0028}\u{0062}\u{2680}\u{0029}\u{0028}\u{0063}\u{0029}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [2, 2, 2, 2, 2, 2, 2, 2],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 4499,
    input: "\u{0061}\u{0028}\u{0062}\u{2680}\u{0029}\u{0028}\u{0029}\u{0063}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
]

///|
test "BidiCharacterTest.txt part 8" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    @debug.assert_eq(
      result.base_level,
      case.expected_base_level,
      msg="case \{case.number}: paragraph base level",
    )
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
