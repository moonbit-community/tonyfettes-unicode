///|
test "conformance: NormalizationTest.txt Part1 - NFC" {
  for i, case in conformance_test_data_part1_2 {
    let (c1, c2, c3, _, _) = case
    // NFC invariants: c2 == NFC(c1) == NFC(c2) == NFC(c3)
    let nfc_c1 = @normalization.nfc(c1)
    let nfc_c2 = @normalization.nfc(c2)
    let nfc_c3 = @normalization.nfc(c3)
    @debug.assert_eq(nfc_c1, c2, msg="NFC(c1) != c2 at index \{i}")
    @debug.assert_eq(nfc_c2, c2, msg="NFC(c2) != c2 at index \{i}")
    @debug.assert_eq(nfc_c3, c2, msg="NFC(c3) != c2 at index \{i}")
  }
}

///|
test "conformance: NormalizationTest.txt Part1 - NFD" {
  for i, case in conformance_test_data_part1_2 {
    let (c1, c2, c3, _, _) = case
    // NFD invariants: c3 == NFD(c1) == NFD(c2) == NFD(c3)
    let nfd_c1 = @normalization.nfd(c1)
    let nfd_c2 = @normalization.nfd(c2)
    let nfd_c3 = @normalization.nfd(c3)
    @debug.assert_eq(nfd_c1, c3, msg="NFD(c1) != c3 at index \{i}")
    @debug.assert_eq(nfd_c2, c3, msg="NFD(c2) != c3 at index \{i}")
    @debug.assert_eq(nfd_c3, c3, msg="NFD(c3) != c3 at index \{i}")
  }
}

///|
test "conformance: NormalizationTest.txt Part1 - NFKC" {
  for i, case in conformance_test_data_part1_2 {
    let (c1, c2, c3, c4, c5) = case
    // NFKC invariants: c4 == NFKC(c1) == NFKC(c2) == NFKC(c3) == NFKC(c4) == NFKC(c5)
    let nfkc_c1 = @normalization.nfkc(c1)
    let nfkc_c2 = @normalization.nfkc(c2)
    let nfkc_c3 = @normalization.nfkc(c3)
    let nfkc_c4 = @normalization.nfkc(c4)
    let nfkc_c5 = @normalization.nfkc(c5)
    @debug.assert_eq(nfkc_c1, c4, msg="NFKC(c1) != c4 at index \{i}")
    @debug.assert_eq(nfkc_c2, c4, msg="NFKC(c2) != c4 at index \{i}")
    @debug.assert_eq(nfkc_c3, c4, msg="NFKC(c3) != c4 at index \{i}")
    @debug.assert_eq(nfkc_c4, c4, msg="NFKC(c4) != c4 at index \{i}")
    @debug.assert_eq(nfkc_c5, c4, msg="NFKC(c5) != c4 at index \{i}")
  }
}

///|
test "conformance: NormalizationTest.txt Part1 - NFKD" {
  for i, case in conformance_test_data_part1_2 {
    let (c1, c2, c3, c4, c5) = case
    // NFKD invariants: c5 == NFKD(c1) == NFKD(c2) == NFKD(c3) == NFKD(c4) == NFKD(c5)
    let nfkd_c1 = @normalization.nfkd(c1)
    let nfkd_c2 = @normalization.nfkd(c2)
    let nfkd_c3 = @normalization.nfkd(c3)
    let nfkd_c4 = @normalization.nfkd(c4)
    let nfkd_c5 = @normalization.nfkd(c5)
    @debug.assert_eq(nfkd_c1, c5, msg="NFKD(c1) != c5 at index \{i}")
    @debug.assert_eq(nfkd_c2, c5, msg="NFKD(c2) != c5 at index \{i}")
    @debug.assert_eq(nfkd_c3, c5, msg="NFKD(c3) != c5 at index \{i}")
    @debug.assert_eq(nfkd_c4, c5, msg="NFKD(c4) != c5 at index \{i}")
    @debug.assert_eq(nfkd_c5, c5, msg="NFKD(c5) != c5 at index \{i}")
  }
}
