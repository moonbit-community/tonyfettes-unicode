supported_targets = "native"

import {
  "moonbit-community/unicode-tools/ucd",
  "moonbit-community/unicode-tools/idna_data",
  "moonbit-community/unicode-tools/bidi_data",
  "moonbit-community/unicode-tools/segmentation_data",
  "moonbitlang/core/argparse",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/shell",
}

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": true,
)
