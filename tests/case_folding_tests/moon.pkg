supported_targets = "-all+native+wasm"

import {
  "moonbit-community/unicode-casefold" @casefold,
  "moonbit-community/unicode-normalization" @normalization,
  "moonbit-community/unicode-tests/support",
  "moonbitlang/core/async",
  "moonbitlang/core/debug",
} for "test"

options(
  "allow-experimental-packages": true,
)
