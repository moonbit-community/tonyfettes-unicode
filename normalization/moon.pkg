import {
  "moonbit-community/unicode-data/ccc",
  "moonbit-community/unicode-data/composition",
  "moonbit-community/unicode-data/decomposition",
  "moonbitlang/core/v128",
}

import {
  "moonbit-community/unicode-normalization" @normalization,
  "moonbit-community/unicode-normalization/internal/base_fuzz" @fuzz,
  "moonbit-community/unicode-normalization/internal/fuzz" @normalization_fuzz,
  "moonbitlang/core/random",
  "moonbitlang/core/bench",
} for "test"

import {
  "moonbitlang/core/debug",
} for "wbtest"

// Only the native and Wasm backends reach the `moonbitlang/core/v128` import,
// so the other backends would report it as unused.

warnings = "-unused_package"
