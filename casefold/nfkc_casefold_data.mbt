///|
/// The mapping of the range holding `c`, as a view of `nfkc_casefold_text`, for
/// a code point of kind 1. None means identity; an empty view means
/// removal.
fn lookup_nfkc_casefold(c : Char) -> StringView? {
  let cp = c.to_int()
  let mut low = 0
  let mut high = nfkc_casefold_starts.length()
  while low < high {
    let mid = (low + high) / 2
    if cp < nfkc_casefold_starts[mid] {
      high = mid
    } else if cp > nfkc_casefold_ends[mid] {
      low = mid + 1
    } else {
      return Some(
        nfkc_casefold_text.unsafe_view(
          start=nfkc_casefold_offsets[mid].to_int(),
          end=nfkc_casefold_offsets[mid + 1].to_int(),
        ),
      )
    }
  }
  None
}
