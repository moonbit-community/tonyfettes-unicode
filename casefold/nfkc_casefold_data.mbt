///|
/// nfkc_casefold kind ranges from 0x40000 packed as `start << 8 | value`
let nfkc_casefold_kind_high_ranges : ReadOnlyArray[Int32] = [
  0x4000000, 0xE000001, 0xE100000,
]

///|
/// How `c` folds: 0 to itself, 1 to the mapping `lookup_nfkc_casefold` finds,
/// and from 2 on to the code point `c + nfkc_casefold_deltas[kind]`.
fn nfkc_casefold_kind(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 8) | 255
    let mut low = 0
    let mut high = nfkc_casefold_kind_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if nfkc_casefold_kind_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return nfkc_casefold_kind_high_ranges[low] & 255
  }
  let mid = (nfkc_casefold_kind_trie_top[cp >> 8].to_int() << 4) |
    ((cp >> 4) & 15)
  let leaf = nfkc_casefold_kind_trie_mid[mid]
  nfkc_casefold_kind_trie_leaf[(leaf << 4) | (cp & 15)].to_int()
}

