///|
/// None means identity; Some("") means removal.
fn lookup_nfkc_casefold(c : Char) -> String? {
  let cp = c.to_int()
  let mut low = 0
  let mut high = nfkc_casefold_starts.length()
  while low < high {
    let mid = (low + high) / 2
    if cp < nfkc_casefold_starts[mid] {
      high = mid
    } else if cp > nfkc_casefold_ends[mid] {
      low = mid + 1
    } else {
      return Some(nfkc_casefold_mappings[mid])
    }
  }
  None
}
