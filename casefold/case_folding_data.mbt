let case_folding_text : String = "\u{0073}\u{0073}\u{0069}\u{0307}\u{02BC}\u{006E}\u{006A}\u{030C}\u{03B9}\u{0308}\u{0301}\u{03C5}\u{0308}\u{0301}\u{0565}\u{0582}\u{0068}\u{0331}\u{0074}\u{0308}\u{0077}\u{030A}\u{0079}\u{030A}\u{0061}\u{02BE}\u{0073}\u{0073}\u{03C5}\u{0313}\u{03C5}\u{0313}\u{0300}\u{03C5}\u{0313}\u{0301}\u{03C5}\u{0313}\u{0342}\u{1F00}\u{03B9}\u{1F01}\u{03B9}\u{1F02}\u{03B9}\u{1F03}\u{03B9}\u{1F04}\u{03B9}\u{1F05}\u{03B9}\u{1F06}\u{03B9}\u{1F07}\u{03B9}\u{1F00}\u{03B9}\u{1F01}\u{03B9}\u{1F02}\u{03B9}\u{1F03}\u{03B9}\u{1F04}\u{03B9}\u{1F05}\u{03B9}\u{1F06}\u{03B9}\u{1F07}\u{03B9}\u{1F20}\u{03B9}\u{1F21}\u{03B9}\u{1F22}\u{03B9}\u{1F23}\u{03B9}\u{1F24}\u{03B9}\u{1F25}\u{03B9}\u{1F26}\u{03B9}\u{1F27}\u{03B9}\u{1F20}\u{03B9}\u{1F21}\u{03B9}\u{1F22}\u{03B9}\u{1F23}\u{03B9}\u{1F24}\u{03B9}\u{1F25}\u{03B9}\u{1F26}\u{03B9}\u{1F27}\u{03B9}\u{1F60}\u{03B9}\u{1F61}\u{03B9}\u{1F62}\u{03B9}\u{1F63}\u{03B9}\u{1F64}\u{03B9}\u{1F65}\u{03B9}\u{1F66}\u{03B9}\u{1F67}\u{03B9}\u{1F60}\u{03B9}\u{1F61}\u{03B9}\u{1F62}\u{03B9}\u{1F63}\u{03B9}\u{1F64}\u{03B9}\u{1F65}\u{03B9}\u{1F66}\u{03B9}\u{1F67}\u{03B9}\u{1F70}\u{03B9}\u{03B1}\u{03B9}\u{03AC}\u{03B9}\u{03B1}\u{0342}\u{03B1}\u{0342}\u{03B9}\u{03B1}\u{03B9}\u{1F74}\u{03B9}\u{03B7}\u{03B9}\u{03AE}\u{03B9}\u{03B7}\u{0342}\u{03B7}\u{0342}\u{03B9}\u{03B7}\u{03B9}\u{03B9}\u{0308}\u{0300}\u{03B9}\u{0308}\u{0301}\u{03B9}\u{0342}\u{03B9}\u{0308}\u{0342}\u{03C5}\u{0308}\u{0300}\u{03C5}\u{0308}\u{0301}\u{03C1}\u{0313}\u{03C5}\u{0342}\u{03C5}\u{0308}\u{0342}\u{1F7C}\u{03B9}\u{03C9}\u{03B9}\u{03CE}\u{03B9}\u{03C9}\u{0342}\u{03C9}\u{0342}\u{03B9}\u{03C9}\u{03B9}\u{0066}\u{0066}\u{0066}\u{0069}\u{0066}\u{006C}\u{0066}\u{0066}\u{0069}\u{0066}\u{0066}\u{006C}\u{0073}\u{0074}\u{0073}\u{0074}\u{0574}\u{0576}\u{0574}\u{0565}\u{0574}\u{056B}\u{057E}\u{0576}\u{0574}\u{056D}\u{0073}\u{0073}"

///|
/// The mapping of `c`, as a view of `case_folding_text`, for
/// a code point of kind 1. None means identity; an empty view means
/// removal.
fn lookup_case_folding(c : Char) -> StringView? {
  let cp = c.to_int()
  let mut low = 0
  let mut high = case_folding_starts.length()
  while low < high {
    let mid = (low + high) / 2
    if cp < case_folding_starts[mid] {
      high = mid
    } else if cp > case_folding_starts[mid] {
      low = mid + 1
    } else {
      return Some(
        case_folding_text.unsafe_view(
          start=case_folding_offsets[mid].to_int(),
          end=case_folding_offsets[mid + 1].to_int(),
        ),
      )
    }
  }
  None
}
