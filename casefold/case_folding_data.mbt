///|
/// None means identity; Some("") means removal.
fn lookup_case_folding(c : Char) -> String? {
  let cp = c.to_int()
  let mut low = 0
  let mut high = case_folding_starts.length()
  while low < high {
    let mid = (low + high) / 2
    if cp < case_folding_starts[mid] {
      high = mid
    } else if cp > case_folding_ends[mid] {
      low = mid + 1
    } else {
      return Some(case_folding_mappings[mid])
    }
  }
  None
}
