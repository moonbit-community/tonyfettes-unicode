///|
/// case_folding kind ranges from 0x40000 packed as `start << 8 | value`
let case_folding_kind_high_ranges : ReadOnlyArray[Int32] = [0x4000000]

///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn case_folding_kind_lookup_supplementary(cp : Int32) -> Int32 {
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 8) | 255
    let mut low = 0
    let mut high = case_folding_kind_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if case_folding_kind_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return case_folding_kind_high_ranges[low] & 255
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (
      case_folding_kind_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() << 4
    ) |
    ((cp >> 4) & 15)
  let leaf = case_folding_kind_supp_mid.unsafe_get(mid).to_int()
  case_folding_kind_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// How `cp` folds in bits 0..6: 0 to itself, 1 to `lookup_case_folding`,
/// and from 2 on to `cp + case_folding_deltas[kind]`.
/// Bit 7 (`0x80`) is set when `cp` or any code point in its folding has CCC != 0 or NFD_QC != Yes.
fn case_folding_kind(cp : Int32) -> Int32 {
  if cp >= 0x10000 {
    return case_folding_kind_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = case_folding_kind_bmp_index.unsafe_get(cp >> 6).to_int()
  case_folding_kind_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}

