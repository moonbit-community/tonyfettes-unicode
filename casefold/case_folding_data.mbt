///|
/// case_folding kind ranges from 0x40000 packed as `start << 8 | value`
let case_folding_kind_high_ranges : ReadOnlyArray[Int32] = [0x4000000]

///|
/// How `c` folds: 0 to itself, 1 to the mapping `lookup_case_folding` finds,
/// and from 2 on to the code point `c + case_folding_deltas[kind]`.
fn case_folding_kind(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 8) | 255
    let mut low = 0
    let mut high = case_folding_kind_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if case_folding_kind_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return case_folding_kind_high_ranges[low] & 255
  }
  let mid = (case_folding_kind_trie_top[cp >> 8].to_int() << 4) |
    ((cp >> 4) & 15)
  let leaf = (case_folding_kind_trie_mid[mid >> 1] >> ((mid & 1) << 4)) & 0xFFFF
  case_folding_kind_trie_leaf[(leaf << 4) | (cp & 15)].to_int()
}

