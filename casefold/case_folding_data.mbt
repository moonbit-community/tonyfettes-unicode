  -48, -33, -7, 63, 116, 211, 217, -42561, -42343, -42319, -42315, -42307, -42305,
  -42282, -42280, -42261, -42258, -35384, -35332, -10783, -10782, -10780, -10749,
  -10743, -10727, -8383, -8262, -7517, -7173, -6222, -6221, -6212, -6211, -6204,
  -6180, -3814, -268, -195, -163, -121, -97, -64, -60, -58, -56, -54, -30, -25, -22,
  -15, 8, 15, 28, 38, 69, 71, 79, 202, 203, 206, 207, 209, 210, 213, 214, 219, 775,
