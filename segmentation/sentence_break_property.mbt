/// Sentence_Break ranges from 0x40000 packed as `start << 4 | value`
let sentence_break_high_ranges : ReadOnlyArray[Int32] = [
  0x400000, 0xE00015, 0xE00020, 0xE00204, 0xE00800, 0xE01004, 0xE01F00,
]

///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn sentence_break_lookup_supplementary(cp : Int32) -> Int32 {
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 4) | 15
    let mut low = 0
    let mut high = sentence_break_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if sentence_break_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return sentence_break_high_ranges[low] & 15
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (
      sentence_break_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() << 4
    ) |
    ((cp >> 4) & 15)
  let leaf = sentence_break_supp_mid.unsafe_get(mid).to_int()
  sentence_break_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// Look up Sentence_Break; unlisted code points have value zero (Other).
fn sentence_break_value(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return sentence_break_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = sentence_break_bmp_index.unsafe_get(cp >> 6).to_int()
  sentence_break_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}
