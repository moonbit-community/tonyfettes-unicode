///|
/// Line break ranges from 0x40000 packed as `start << 8 | value`
let line_break_high_ranges : ReadOnlyArray[Int32] = [
  0x4000002, 0xE000130, 0xE000202, 0xE002030, 0xE008002, 0xE010030, 0xE01F002,
]

///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn line_break_lookup_supplementary(cp : Int32) -> Int32 {
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 8) | 255
    let mut low = 0
    let mut high = line_break_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if line_break_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return line_break_high_ranges[low] & 255
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (line_break_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() << 4) |
    ((cp >> 4) & 15)
  let leaf = line_break_supp_mid.unsafe_get(mid).to_int()
  line_break_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// Look up the packed UAX #14 line break properties of a code point:
/// `potential_emoji << 7 | east_asian << 6 | resolved_class`.
fn line_break_value(cp : Int32) -> Int32 {
  if cp >= 0x10000 {
    return line_break_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = line_break_bmp_index.unsafe_get(cp >> 6).to_int()
  line_break_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}
