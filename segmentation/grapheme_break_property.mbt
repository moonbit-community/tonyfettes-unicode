///|
/// Grapheme break ranges from 0x40000 packed as `start << 7 | value`
let grapheme_break_high_ranges : ReadOnlyArray[Int32] = [
  0x2000000, 0x7000003, 0x7001024, 0x7004003, 0x7008024, 0x700F803, 0x7080000,
]

///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn grapheme_break_lookup_supplementary(cp : Int32) -> Int32 {
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 7) | 127
    let mut low = 0
    let mut high = grapheme_break_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if grapheme_break_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return grapheme_break_high_ranges[low] & 127
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (
      grapheme_break_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() << 4
    ) |
    ((cp >> 4) & 15)
  let leaf = grapheme_break_supp_mid.unsafe_get(mid).to_int()
  grapheme_break_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// Look up the packed grapheme cluster break properties of a code point:
/// `extended_pictographic << 6 | indic_conjunct_break << 4 |
/// grapheme_cluster_break`.
fn grapheme_break_value(cp : Int32) -> Int32 {
  if cp >= 0x10000 {
    return grapheme_break_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = grapheme_break_bmp_index.unsafe_get(cp >> 6).to_int()
  grapheme_break_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}
