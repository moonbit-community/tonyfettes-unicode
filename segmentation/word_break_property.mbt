///|
/// Word_Break ranges from 0x40000 packed as `start << 5 | value`
let word_break_high_ranges : ReadOnlyArray[Int32] = [
  0x800000, 0x1C00027, 0x1C00040, 0x1C00404, 0x1C01000, 0x1C02004, 0x1C03E00,
]

///|
/// Look up Word_Break; unlisted code points have value zero (Other).
fn word_break_value(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 5) | 31
    let mut low = 0
    let mut high = word_break_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if word_break_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return word_break_high_ranges[low] & 31
  }
  let mid = (word_break_trie_top[cp >> 8].to_int() << 4) | ((cp >> 4) & 15)
  let leaf = (word_break_trie_mid[mid >> 1] >> ((mid & 1) << 4)) & 0xFFFF
  word_break_trie_leaf[(leaf << 4) | (cp & 15)].to_int()
}
