///|
/// IDNA2008 ranges from 0x40000 packed as `start << 4 | value`
let idna2008_high_ranges : ReadOnlyArray[Int32] = [0x400000]

///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn idna2008_lookup_supplementary(cp : Int32) -> Int32 {
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 4) | 15
    let mut low = 0
    let mut high = idna2008_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if idna2008_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return idna2008_high_ranges[low] & 15
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (idna2008_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() << 4) |
    ((cp >> 4) & 15)
  let leaf = idna2008_supp_mid.unsafe_get(mid).to_int()
  idna2008_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// Bits for IDNA2008 allowed characters (1), Greek (2), Hebrew (4),
/// and Hiragana, Katakana or Han (8).
fn lookup_idna_property_bits(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return idna2008_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = idna2008_bmp_index.unsafe_get(cp >> 6).to_int()
  idna2008_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}

///|
/// IDNA2008 character validity and CONTEXTO Script properties.
struct IdnaProperties(Int32)

///|
/// Look up a character's IDNA properties once for all needed checks.
pub fn lookup_idna_properties(c : Char) -> IdnaProperties {
  IdnaProperties(lookup_idna_property_bits(c))
}

///|
/// Whether a character is PVALID, CONTEXTJ or CONTEXTO in IDNA2008.
pub fn IdnaProperties::is_idna2008_allowed(self : IdnaProperties) -> Bool {
  (self.0 & 1) != 0
}

///|
/// Whether a character has Script=Greek.
pub fn IdnaProperties::is_greek(self : IdnaProperties) -> Bool {
  (self.0 & 2) != 0
}

///|
/// Whether a character has Script=Hebrew.
pub fn IdnaProperties::is_hebrew(self : IdnaProperties) -> Bool {
  (self.0 & 4) != 0
}

///|
/// Whether a character has Script=Hiragana, Katakana or Han.
pub fn IdnaProperties::is_japanese(self : IdnaProperties) -> Bool {
  (self.0 & 8) != 0
}
