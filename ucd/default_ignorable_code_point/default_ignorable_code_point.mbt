///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn default_ignorable_code_point_lookup_supplementary(cp : Int32) -> Bool {
  if cp >= 0x40000 {
    return (cp >= 0xE0000 && cp <= 0xE0000) ||
      (cp >= 0xE0001 && cp <= 0xE0001) ||
      (cp >= 0xE0002 && cp <= 0xE001F) ||
      (cp >= 0xE0020 && cp <= 0xE007F) ||
      (cp >= 0xE0080 && cp <= 0xE00FF) ||
      (cp >= 0xE0100 && cp <= 0xE01EF) ||
      (cp >= 0xE01F0 && cp <= 0xE0FFF)
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (
      default_ignorable_code_point_supp_top
      .unsafe_get((cp - 0x10000) >> 10)
      .to_int() <<
      3
    ) |
    ((cp >> 7) & 7)
  let leaf = default_ignorable_code_point_supp_mid.unsafe_get(mid).to_int()
  let bits = default_ignorable_code_point_supp_leaf
    .unsafe_get((leaf << 4) | ((cp >> 3) & 15))
    .to_int()
  ((bits >> (cp & 7)) & 1) != 0
}

///|
/// Check whether a character has the Unicode Default_Ignorable_Code_Point property
pub fn is_default_ignorable_code_point(c : Char) -> Bool {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return default_ignorable_code_point_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let leaf = default_ignorable_code_point_bmp_index.unsafe_get(cp >> 8).to_int()
  let bits = default_ignorable_code_point_bmp_leaf
    .unsafe_get((leaf << 5) | ((cp >> 3) & 31))
    .to_int()
  ((bits >> (cp & 7)) & 1) != 0
}
