///|
/// Index of the record holding a character's case mappings
fn lookup_case_record(c : Char) -> Int {
  let cp = c.to_int()
  if cp >= 0x20000 {
    return 0
  }
  let mid = (case_trie_top[cp >> 8].to_int() << 4) | ((cp >> 4) & 15)
  let leaf = case_trie_mid[mid].to_int()
  case_trie_leaf[(leaf << 4) | (cp & 15)].to_int()
}

///|
/// Binary search helper - returns index if found, -1 otherwise
fn binary_search_case(arr : ReadOnlyArray[Int], cp : Int) -> Int {
  let mut left = 0
  let mut right = arr.length() - 1

  while left <= right {
    let mid = (left + right) / 2
    let mid_cp = arr[mid]

    if cp < mid_cp {
      right = mid - 1
    } else if cp > mid_cp {
      left = mid + 1
    } else {
      return mid
    }
  }

  -1
}

///|
/// Look up simple uppercase mapping for a character
/// Returns the character itself if no mapping exists
pub fn lookup_simple_uppercase(c : Char) -> Char {
  (c.to_int() + case_upper_deltas[lookup_case_record(c)]).unsafe_to_char()
}

///|
/// Full uppercase mapping of a character as a string
/// Returns the character itself if no mapping exists
pub fn full_uppercase(c : Char) -> String {
  let record = lookup_case_record(c)
  if (case_special_flags[record].to_int() & 1) != 0 {
    let index = binary_search_case(special_upper_cps, c.to_int())
    if index >= 0 {
      return special_upper_strings[index]
    }
  }
  let target = c.to_int() + case_upper_deltas[record]
  if target < 0x80 {
    ascii_strings[target]
  } else {
    target.unsafe_to_char().to_string()
  }
}

///|
/// Look up full uppercase mapping for a character
/// Returns Some(array of chars) if a mapping exists, None otherwise
pub fn lookup_full_uppercase(c : Char) -> Array[Char]? {
  let record = lookup_case_record(c)
  if (case_special_flags[record].to_int() & 1) != 0 {
    let index = binary_search_case(special_upper_cps, c.to_int())
    if index >= 0 {
      return Some(special_upper_strings[index].to_array())
    }
  }
  let delta = case_upper_deltas[record]
  if delta == 0 {
    None
  } else {
    Some([(c.to_int() + delta).unsafe_to_char()])
  }
}

///|
/// Look up simple lowercase mapping for a character
/// Returns the character itself if no mapping exists
pub fn lookup_simple_lowercase(c : Char) -> Char {
  (c.to_int() + case_lower_deltas[lookup_case_record(c)]).unsafe_to_char()
}

