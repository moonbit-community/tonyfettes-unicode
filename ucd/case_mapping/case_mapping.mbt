///|
/// One-character strings of the ASCII characters, so that mapping to one allocates nothing
let ascii_strings : ReadOnlyArray[String] = [
  "\u{0000}", "\u{0001}", "\u{0002}", "\u{0003}", "\u{0004}", "\u{0005}", "\u{0006}",
  "\u{0007}", "\u{0008}", "\u{0009}", "\u{000A}", "\u{000B}", "\u{000C}", "\u{000D}",
