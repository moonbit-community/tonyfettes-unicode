///|
/// Cold supplementary case record lookup for `cp >= 0x10000`.
#inline(never)
fn lookup_case_record_supp(cp : Int32) -> Int32 {
  if cp >= 0x20000 {
    return 0
  }
  // SAFETY: cp is in [0x10000, 0x20000); generator validated all indices.
  let mid = (case_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() << 4) |
    ((cp >> 4) & 15)
  let leaf = case_supp_mid.unsafe_get(mid).to_int()
  case_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// Index of the record holding a BMP code point's case mappings (`0 <= cp < 0x10000`).
fn lookup_case_record_bmp(cp : Int32) -> Int32 {
  // SAFETY: callers guarantee cp is in [0, 0x10000); generator validated all indices.
  let block = case_bmp_index.unsafe_get(cp >> 6).to_int()
  case_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}

///|
/// Index of the record holding a character's case mappings
fn lookup_case_record(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return lookup_case_record_supp(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = case_bmp_index.unsafe_get(cp >> 6).to_int()
  case_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}

///|
/// Look up simple uppercase mapping for a character
/// Returns the character itself if no mapping exists
pub fn lookup_simple_uppercase(c : Char) -> Char {
  (c.to_int() + case_upper_deltas.unsafe_get(lookup_case_record(c))).unsafe_to_char()
}

///|
/// Full uppercase mapping of a character as a string
/// Returns the character itself if no mapping exists
pub fn full_uppercase(c : Char) -> String {
  let record = lookup_case_record(c)
  if (case_special_flags.unsafe_get(record).to_int() & 1) != 0 {
    let index = find_special_upper(c.to_int())
    if index >= 0 {
      return special_upper_strings[index]
    }
  }
  let target = c.to_int() + case_upper_deltas.unsafe_get(record)
  if target < 0x80 {
    ascii_strings.unsafe_get(target)
  } else {
    target.unsafe_to_char().to_string()
  }
}

///|
/// Look up full uppercase mapping for a character
/// Returns Some(array of chars) if a mapping exists, None otherwise
pub fn lookup_full_uppercase(c : Char) -> Array[Char]? {
  let record = lookup_case_record(c)
  if (case_special_flags.unsafe_get(record).to_int() & 1) != 0 {
    let index = find_special_upper(c.to_int())
    if index >= 0 {
      return Some(special_upper_strings[index].to_array())
    }
  }
  let delta = case_upper_deltas.unsafe_get(record)
  if delta == 0 {
    None
  } else {
    Some([(c.to_int() + delta).unsafe_to_char()])
  }
}

///|
/// Index of `key` in the sorted array `special_upper_cps`, or -1 if it is absent.
fn find_special_upper(key : Int32) -> Int32 {
  let mut left = 0
  let mut right = special_upper_cps.length() - 1
  while left <= right {
    let mid = (left + right) / 2
    let value = special_upper_cps[mid]
    if key < value {
      right = mid - 1
    } else if key > value {
      left = mid + 1
    } else {
      return mid
    }
  }
  -1
}

///|
/// Look up simple lowercase mapping for a character
/// Returns the character itself if no mapping exists
pub fn lookup_simple_lowercase(c : Char) -> Char {
  (c.to_int() + case_lower_deltas.unsafe_get(lookup_case_record(c))).unsafe_to_char()
}

///|
/// Full lowercase mapping of a character as a string
/// Returns the character itself if no mapping exists
pub fn full_lowercase(c : Char) -> String {
  let record = lookup_case_record(c)
  if (case_special_flags.unsafe_get(record).to_int() & 2) != 0 {
    let index = find_special_lower(c.to_int())
    if index >= 0 {
      return special_lower_strings[index]
    }
  }
  let target = c.to_int() + case_lower_deltas.unsafe_get(record)
  if target < 0x80 {
    ascii_strings.unsafe_get(target)
  } else {
    target.unsafe_to_char().to_string()
  }
}

///|
/// Look up full lowercase mapping for a character
/// Returns Some(array of chars) if a mapping exists, None otherwise
pub fn lookup_full_lowercase(c : Char) -> Array[Char]? {
  let record = lookup_case_record(c)
  if (case_special_flags.unsafe_get(record).to_int() & 2) != 0 {
    let index = find_special_lower(c.to_int())
    if index >= 0 {
      return Some(special_lower_strings[index].to_array())
    }
  }
  let delta = case_lower_deltas.unsafe_get(record)
  if delta == 0 {
    None
  } else {
    Some([(c.to_int() + delta).unsafe_to_char()])
  }
}

///|
/// Index of `key` in the sorted array `special_lower_cps`, or -1 if it is absent.
fn find_special_lower(key : Int32) -> Int32 {
  let mut left = 0
  let mut right = special_lower_cps.length() - 1
  while left <= right {
    let mid = (left + right) / 2
    let value = special_lower_cps[mid]
    if key < value {
      right = mid - 1
    } else if key > value {
      left = mid + 1
    } else {
      return mid
    }
  }
  -1
}

///|
/// Look up simple titlecase mapping for a character
/// Returns the character itself if no mapping exists
pub fn lookup_simple_titlecase(c : Char) -> Char {
  (c.to_int() + case_title_deltas.unsafe_get(lookup_case_record(c))).unsafe_to_char()
}

///|
/// Full titlecase mapping of a character as a string
/// Returns the character itself if no mapping exists
pub fn full_titlecase(c : Char) -> String {
  let record = lookup_case_record(c)
  if (case_special_flags.unsafe_get(record).to_int() & 4) != 0 {
    let index = find_special_title(c.to_int())
    if index >= 0 {
      return special_title_strings[index]
    }
  }
  let target = c.to_int() + case_title_deltas.unsafe_get(record)
  if target < 0x80 {
    ascii_strings.unsafe_get(target)
  } else {
    target.unsafe_to_char().to_string()
  }
}

///|
/// Look up full titlecase mapping for a character
/// Returns Some(array of chars) if a mapping exists, None otherwise
pub fn lookup_full_titlecase(c : Char) -> Array[Char]? {
  let record = lookup_case_record(c)
  if (case_special_flags.unsafe_get(record).to_int() & 4) != 0 {
    let index = find_special_title(c.to_int())
    if index >= 0 {
      return Some(special_title_strings[index].to_array())
    }
  }
  let delta = case_title_deltas.unsafe_get(record)
  if delta == 0 {
    None
  } else {
    Some([(c.to_int() + delta).unsafe_to_char()])
  }
}

///|
/// Index of `key` in the sorted array `special_title_cps`, or -1 if it is absent.
fn find_special_title(key : Int32) -> Int32 {
  let mut left = 0
  let mut right = special_title_cps.length() - 1
  while left <= right {
    let mid = (left + right) / 2
    let value = special_title_cps[mid]
    if key < value {
      right = mid - 1
    } else if key > value {
      left = mid + 1
    } else {
      return mid
    }
  }
  -1
}
