  "\u{001C}", "\u{001D}", "\u{001E}", "\u{001F}", "\u{0020}", "\u{0021}", "\u{0022}",
  "\u{0023}", "\u{0024}", "\u{0025}", "\u{0026}", "\u{0027}", "\u{0028}", "\u{0029}",
  "\u{002A}", "\u{002B}", "\u{002C}", "\u{002D}", "\u{002E}", "\u{002F}", "\u{0030}",
