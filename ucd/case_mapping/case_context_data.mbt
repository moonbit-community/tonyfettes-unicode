///|
/// Check whether a character has the Unicode Cased property
fn is_cased(c : Char) -> Bool {
  let cp = c.to_int()
  if cp >= 0x40000 {
    return false
  }
  let mid = (cased_trie_top[cp >> 10].to_int() << 3) | ((cp >> 7) & 7)
  let leaf = cased_trie_mid[mid].to_int()
  let bits = cased_trie_leaf[(leaf << 4) | ((cp >> 3) & 15)].to_int()
  ((bits >> (cp & 7)) & 1) != 0
}

