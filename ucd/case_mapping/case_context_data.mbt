///|
/// Check whether a character has the Unicode Case_Ignorable property
fn is_case_ignorable(c : Char) -> Bool {
  let cp = c.to_int()
  if cp >= 0x40000 {
    return (cp >= 0xE0001 && cp <= 0xE0001) ||
      (cp >= 0xE0020 && cp <= 0xE007F) ||
      (cp >= 0xE0100 && cp <= 0xE01EF)
  }
  let mid = (case_ignorable_trie_top[cp >> 10].to_int() << 3) | ((cp >> 7) & 7)
  let leaf = case_ignorable_trie_mid[mid].to_int()
  let bits = case_ignorable_trie_leaf[(leaf << 4) | ((cp >> 3) & 15)].to_int()
  ((bits >> (cp & 7)) & 1) != 0
}
