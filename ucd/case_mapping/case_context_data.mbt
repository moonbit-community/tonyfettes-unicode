///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn case_ignorable_lookup_supplementary(cp : Int32) -> Bool {
  if cp >= 0x40000 {
    return (cp >= 0xE0001 && cp <= 0xE0001) ||
      (cp >= 0xE0020 && cp <= 0xE007F) ||
      (cp >= 0xE0100 && cp <= 0xE01EF)
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (
      case_ignorable_supp_top.unsafe_get((cp - 0x10000) >> 10).to_int() << 3
    ) |
    ((cp >> 7) & 7)
  let leaf = case_ignorable_supp_mid.unsafe_get(mid).to_int()
  let bits = case_ignorable_supp_leaf
    .unsafe_get((leaf << 4) | ((cp >> 3) & 15))
    .to_int()
  ((bits >> (cp & 7)) & 1) != 0
}

///|
/// Check whether a character has the Unicode Case_Ignorable property
fn is_case_ignorable(c : Char) -> Bool {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return case_ignorable_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let leaf = case_ignorable_bmp_index.unsafe_get(cp >> 8).to_int()
  let bits = case_ignorable_bmp_leaf
    .unsafe_get((leaf << 5) | ((cp >> 3) & 31))
    .to_int()
  ((bits >> (cp & 7)) & 1) != 0
}
