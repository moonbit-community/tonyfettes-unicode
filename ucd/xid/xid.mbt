///|
/// Check whether a character has the Unicode XID_Continue property
pub fn is_xid_continue(c : Char) -> Bool {
  let cp = c.to_int()
  if cp >= 0x40000 {
    return cp >= 0xE0100 && cp <= 0xE01EF
  }
  let mid = (xid_continue_trie_top[cp >> 10].to_int() << 3) | ((cp >> 7) & 7)
  let leaf = xid_continue_trie_mid[mid].to_int()
  let bits = xid_continue_trie_leaf[(leaf << 4) | ((cp >> 3) & 15)].to_int()
  ((bits >> (cp & 7)) & 1) != 0
}
