///|
/// Joining_Group ranges from 0x40000 packed as `start << 7 | value`
let joining_group_high_ranges : ReadOnlyArray[Int32] = [0x2000052]

///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn joining_group_lookup_supplementary(cp : Int32) -> Int32 {
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 7) | 127
    let mut low = 0
    let mut high = joining_group_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if joining_group_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return joining_group_high_ranges[low] & 127
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (
      joining_group_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() << 4
    ) |
    ((cp >> 4) & 15)
  let leaf = joining_group_supp_mid.unsafe_get(mid).to_int()
  joining_group_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// Look up Joining_Group ordinal for a character
/// Returns ordinal value (0-115) corresponding to JoiningGroup enum
pub fn lookup_joining_group(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return joining_group_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = joining_group_bmp_index.unsafe_get(cp >> 6).to_int()
  joining_group_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}
