///|
/// Joining_Group ranges from 0x40000 packed as `start << 7 | value`
let joining_group_high_ranges : ReadOnlyArray[Int32] = [0x2000052]

///|
/// Look up Joining_Group ordinal for a character
/// Returns ordinal value (0-115) corresponding to JoiningGroup enum
pub fn lookup_joining_group(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 7) | 127
    let mut low = 0
    let mut high = joining_group_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if joining_group_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return joining_group_high_ranges[low] & 127
  }
  let mid = (joining_group_trie_top[cp >> 8].to_int() << 4) | ((cp >> 4) & 15)
  let leaf = (joining_group_trie_mid[2 * mid].to_int() << 8) |
    joining_group_trie_mid[2 * mid + 1].to_int()
  joining_group_trie_leaf[(leaf << 4) | (cp & 15)].to_int()
}
