///|
/// East_Asian_Width ranges from 0x40000 packed as `start << 3 | value`
let eaw_high_ranges : ReadOnlyArray[Int32] = [
  0x200003, 0x700800, 0x700F83, 0x780000, 0x7FFFF3, 0x800000, 0x87FFF3,
]

///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn eaw_lookup_supplementary(cp : Int32) -> Int32 {
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 3) | 7
    let mut low = 0
    let mut high = eaw_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if eaw_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return eaw_high_ranges[low] & 7
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (eaw_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() << 4) |
    ((cp >> 4) & 15)
  let leaf = eaw_supp_mid.unsafe_get(mid).to_int()
  eaw_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// Look up East_Asian_Width ordinal for a character
/// Returns ordinal value (0-5) corresponding to EastAsianWidth enum
pub fn lookup_east_asian_width(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return eaw_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = eaw_bmp_index.unsafe_get(cp >> 6).to_int()
  eaw_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}
