///|
/// Joining_Type ranges from 0x40000 packed as `start << 3 | value`
let joining_type_high_ranges : ReadOnlyArray[Int32] = [
  0x200000, 0x70000D, 0x700010, 0x700105, 0x700400, 0x700805, 0x700F80,
]

///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn joining_type_lookup_supplementary(cp : Int32) -> Int32 {
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 3) | 7
    let mut low = 0
    let mut high = joining_type_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if joining_type_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return joining_type_high_ranges[low] & 7
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (
      joining_type_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() << 4
    ) |
    ((cp >> 4) & 15)
  let leaf = joining_type_supp_mid.unsafe_get(mid).to_int()
  joining_type_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// Look up Joining_Type ordinal for a character
/// Returns ordinal value (0-5) corresponding to JoiningType enum
pub fn lookup_joining_type(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return joining_type_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = joining_type_bmp_index.unsafe_get(cp >> 6).to_int()
  joining_type_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}
