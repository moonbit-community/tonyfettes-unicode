///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn alphabetic_lookup_supplementary(cp : Int32) -> Bool {
  if cp >= 0x40000 {
    return false
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (alphabetic_supp_top.unsafe_get((cp - 0x10000) >> 10).to_int() << 3) |
    ((cp >> 7) & 7)
  let leaf = alphabetic_supp_mid.unsafe_get(mid).to_int()
  let bits = alphabetic_supp_leaf
    .unsafe_get((leaf << 4) | ((cp >> 3) & 15))
    .to_int()
  ((bits >> (cp & 7)) & 1) != 0
}

///|
/// Check whether a character has the Unicode Alphabetic property
pub fn is_alphabetic(c : Char) -> Bool {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return alphabetic_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let leaf = alphabetic_bmp_index.unsafe_get(cp >> 8).to_int()
  let bits = alphabetic_bmp_leaf
    .unsafe_get((leaf << 5) | ((cp >> 3) & 31))
    .to_int()
  ((bits >> (cp & 7)) & 1) != 0
}
