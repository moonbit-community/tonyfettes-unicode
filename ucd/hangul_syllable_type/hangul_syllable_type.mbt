///|
/// Hangul_Syllable_Type ranges from 0x40000 packed as `start << 3 | value`
let hangul_syllable_type_high_ranges : ReadOnlyArray[Int32] = [0x200000]

///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn hangul_syllable_type_lookup_supplementary(cp : Int32) -> Int32 {
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 3) | 7
    let mut low = 0
    let mut high = hangul_syllable_type_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if hangul_syllable_type_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return hangul_syllable_type_high_ranges[low] & 7
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (
      hangul_syllable_type_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() <<
      4
    ) |
    ((cp >> 4) & 15)
  let leaf = hangul_syllable_type_supp_mid.unsafe_get(mid).to_int()
  hangul_syllable_type_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// Look up Hangul_Syllable_Type ordinal for a character
/// Returns ordinal value (0-5) corresponding to HangulSyllableType enum
pub fn lookup_hangul_syllable_type(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return hangul_syllable_type_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = hangul_syllable_type_bmp_index.unsafe_get(cp >> 6).to_int()
  hangul_syllable_type_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}
