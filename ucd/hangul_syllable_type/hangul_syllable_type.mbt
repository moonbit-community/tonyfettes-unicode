///|
/// Hangul_Syllable_Type ranges from 0x40000 packed as `start << 3 | value`
let hangul_syllable_type_high_ranges : ReadOnlyArray[Int32] = [0x200000]

///|
/// Look up Hangul_Syllable_Type ordinal for a character
/// Returns ordinal value (0-5) corresponding to HangulSyllableType enum
pub fn lookup_hangul_syllable_type(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 3) | 7
    let mut low = 0
    let mut high = hangul_syllable_type_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if hangul_syllable_type_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return hangul_syllable_type_high_ranges[low] & 7
  }
  let mid = (hangul_syllable_type_trie_top[cp >> 8].to_int() << 4) |
    ((cp >> 4) & 15)
  let leaf = (hangul_syllable_type_trie_mid[2 * mid].to_int() << 8) |
    hangul_syllable_type_trie_mid[2 * mid + 1].to_int()
  hangul_syllable_type_trie_leaf[(leaf << 4) | (cp & 15)].to_int()
}
