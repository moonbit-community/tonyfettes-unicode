///|
/// Line_Break ranges from 0x40000 packed as `start << 6 | value`
let line_break_high_ranges : ReadOnlyArray[Int32] = [
  0x100002E, 0x380004C, 0x38000AE, 0x380080C, 0x380202E, 0x380400C, 0x3807C2E,
]

///|
/// Look up Line_Break ordinal for a character
/// Returns ordinal value (0-48) corresponding to LineBreak enum
pub fn lookup_line_break(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 6) | 63
    let mut low = 0
    let mut high = line_break_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if line_break_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return line_break_high_ranges[low] & 63
  }
  let mid = (line_break_trie_top[cp >> 8].to_int() << 4) | ((cp >> 4) & 15)
  let leaf = (line_break_trie_mid[mid >> 1] >> ((mid & 1) << 4)) & 0xFFFF
  line_break_trie_leaf[(leaf << 4) | (cp & 15)].to_int()
}
