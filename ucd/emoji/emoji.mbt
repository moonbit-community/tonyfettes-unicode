///|
/// Check whether a character has the Unicode Emoji_Presentation property
pub fn is_emoji_presentation(c : Char) -> Bool {
  let cp = c.to_int()
  if cp >= 0x40000 {
    return false
  }
  let mid = (emoji_presentation_trie_top[cp >> 10].to_int() << 3) |
    ((cp >> 7) & 7)
  let leaf = emoji_presentation_trie_mid[mid].to_int()
  let bits = emoji_presentation_trie_leaf[(leaf << 4) | ((cp >> 3) & 15)].to_int()
  ((bits >> (cp & 7)) & 1) != 0
}

