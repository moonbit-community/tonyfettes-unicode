///|
/// Check whether a character is punctuation (General_Category group P)
pub fn is_punctuation(c : Char) -> Bool {
  let cp = c.to_int()
  if cp >= 0x40000 {
    return false
  }
  let mid = (punctuation_trie_top[cp >> 10].to_int() << 3) | ((cp >> 7) & 7)
  let leaf = punctuation_trie_mid[mid].to_int()
  let bits = punctuation_trie_leaf[(leaf << 4) | ((cp >> 3) & 15)].to_int()
  ((bits >> (cp & 7)) & 1) != 0
}
