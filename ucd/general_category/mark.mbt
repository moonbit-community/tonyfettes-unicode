///|
/// Check whether a character is a mark (General_Category Mn, Mc, or Me)
pub fn is_mark(c : Char) -> Bool {
  let cp = c.to_int()
  if cp >= 0x40000 {
    return cp >= 0xE0100 && cp <= 0xE01EF
  }
  let mid = (mark_trie_top[cp >> 10].to_int() << 3) | ((cp >> 7) & 7)
  let leaf = mark_trie_mid[mid].to_int()
  let bits = mark_trie_leaf[(leaf << 4) | ((cp >> 3) & 15)].to_int()
  ((bits >> (cp & 7)) & 1) != 0
}
