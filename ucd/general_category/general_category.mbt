///|
/// General_Category ranges from 0x40000 packed as `start << 5 | value`
let gc_high_ranges : ReadOnlyArray[Int32] = [
  0x80001D, 0x1C0003A, 0x1C0005D, 0x1C0041A, 0x1C0101D, 0x1C02005, 0x1C03E1D, 0x1E0001C,
  0x1FFFFDD, 0x200001C, 0x21FFFDD,
]

///|
/// Cold supplementary lookup for `cp >= 0x10000`.
#inline(never)
fn gc_lookup_supplementary(cp : Int32) -> Int32 {
  if cp >= 0x40000 {
    // Binary search for the last range starting at or before `cp`.
    let key = (cp << 5) | 31
    let mut low = 0
    let mut high = gc_high_ranges.length()
    while high - low > 1 {
      let mid = (low + high) / 2
      if gc_high_ranges[mid] <= key {
        low = mid
      } else {
        high = mid
      }
    }
    return gc_high_ranges[low] & 31
  }
  // SAFETY: cp is in [0x10000, 0x40000); generator validated all indices.
  let mid = (gc_supp_top.unsafe_get((cp - 0x10000) >> 8).to_int() << 4) |
    ((cp >> 4) & 15)
  let leaf = gc_supp_mid.unsafe_get(mid)
  gc_supp_leaf.unsafe_get((leaf << 4) | (cp & 15)).to_int()
}

///|
/// Look up General_Category ordinal for a character
/// Returns ordinal value (0-29) corresponding to GeneralCategory enum
pub fn lookup_general_category(c : Char) -> Int32 {
  let cp = c.to_int()
  if cp >= 0x10000 {
    return gc_lookup_supplementary(cp)
  }
  // SAFETY: cp is in [0, 0x10000); generator validated all indices.
  let block = gc_bmp_index.unsafe_get(cp >> 6).to_int()
  gc_bmp_leaf.unsafe_get((block << 6) | (cp & 63)).to_int()
}
