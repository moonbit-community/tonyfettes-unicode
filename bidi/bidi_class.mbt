///|
/// Full Bidi_Class lookup for Unicode Bidirectional Algorithm (UAX #9)
/// Generated from DerivedBidiClass.txt

///|
/// All 23 Bidi_Class values from UAX #9
#derive(Debug, Eq)
pub(all) enum BidiClass {
  L // Left_To_Right
  R // Right_To_Left
  AL // Arabic_Letter
  EN // European_Number
  ES // European_Separator
  ET // European_Terminator
  AN // Arabic_Number
  CS // Common_Separator
  NSM // Nonspacing_Mark
  BN // Boundary_Neutral
  B // Paragraph_Separator
  S // Segment_Separator
  WS // White_Space
  ON // Other_Neutral
  LRE // Left_To_Right_Embedding
  LRO // Left_To_Right_Override
  RLE // Right_To_Left_Embedding
  RLO // Right_To_Left_Override
  PDF // Pop_Directional_Format
  LRI // Left_To_Right_Isolate
  RLI // Right_To_Left_Isolate
  FSI // First_Strong_Isolate
  PDI // Pop_Directional_Isolate
}

///|
#deprecated("Use `Debug::to_repr` instead", skip_current_package=true)
#doc(hidden)
pub extend BidiClass with Debug::{to_repr}

///|
pub extend BidiClass with Eq::{not_equal, equal}

///|
pub extend BidiClass with Show::{to_string, output}

///|
pub impl Show for BidiClass with fn output(self, logger) {
  logger.write_string(
    match self {
      L => "L"
      R => "R"
      AL => "AL"
      EN => "EN"
      ES => "ES"
      ET => "ET"
      AN => "AN"
      CS => "CS"
      NSM => "NSM"
      BN => "BN"
      B => "B"
      S => "S"
      WS => "WS"
      ON => "ON"
      LRE => "LRE"
      LRO => "LRO"
      RLE => "RLE"
      RLO => "RLO"
      PDF => "PDF"
      LRI => "LRI"
      RLI => "RLI"
      FSI => "FSI"
      PDI => "PDI"
    },
  )
}

///|
/// Convert a BidiClass ordinal, below 23, to the enum value.
///
/// A constructor without arguments is its ordinal on every backend. A
/// `match` or a table would cost a jump table or a load on wasm, wasm-gc
/// and JS, slower there than the trie lookup itself.
fn bidi_from_code(ordinal : Int32) -> BidiClass = "%identity"

