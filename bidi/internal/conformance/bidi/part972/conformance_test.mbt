    input: "\u{202C}\u{0009}\u{002B}\u{2066}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 486488,
    input: "\u{202C}\u{0009}\u{002B}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 486489,
    input: "\u{202C}\u{0009}\u{002B}\u{2067}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 486490,
    input: "\u{202C}\u{0009}\u{002B}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 486491,
    input: "\u{202C}\u{0009}\u{002B}\u{2068}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 486492,
    input: "\u{202C}\u{0009}\u{002B}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 486493,
    input: "\u{202C}\u{0009}\u{002B}\u{2069}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 486494,
    input: "\u{202C}\u{0009}\u{002B}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 486495,
    input: "\u{202C}\u{0009}\u{0024}\u{0061}",
    direction: None,
    expected_levels: [-1, 0, 0, 0],
