    input: "\u{2068}\u{0627}\u{0030}\u{200B}",
    direction: None,
    expected_levels: [0, 1, 2, -1],
    expected_reorder: [0, 2, 1],
  },
  {
    number: 309998,
    input: "\u{2068}\u{0627}\u{0030}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 1, 2, -1],
    expected_reorder: [0, 2, 1],
  },
  {
    number: 309999,
    input: "\u{2068}\u{0627}\u{0660}\u{202A}",
    direction: None,
    expected_levels: [0, 1, 2, -1],
    expected_reorder: [0, 2, 1],
  },
]

///|
test "BidiTest.txt part 61" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
