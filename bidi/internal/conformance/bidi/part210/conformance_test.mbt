    expected_reorder: [0, 3],
  },
  {
    number: 105490,
    input: "\u{0024}\u{202C}\u{202C}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 105491,
    input: "\u{0024}\u{202C}\u{202C}\u{2068}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 105492,
    input: "\u{0024}\u{202C}\u{202C}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 105493,
    input: "\u{0024}\u{202C}\u{202C}\u{2069}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 105494,
    input: "\u{0024}\u{202C}\u{202C}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 105495,
    input: "\u{0024}\u{202C}\u{200B}\u{0061}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
