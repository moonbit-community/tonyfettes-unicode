    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 108491,
    input: "\u{0021}\u{202C}\u{202A}\u{000A}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 108492,
    input: "\u{0021}\u{202C}\u{202A}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 108493,
    input: "\u{0021}\u{202C}\u{202A}\u{0009}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 108494,
    input: "\u{0021}\u{202C}\u{202A}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 108495,
    input: "\u{0021}\u{202C}\u{202A}\u{0020}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 108496,
    input: "\u{0021}\u{202C}\u{202A}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 108497,
    input: "\u{0021}\u{202C}\u{202A}\u{2066}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 108498,
    input: "\u{0021}\u{202C}\u{202A}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
  {
    number: 108499,
    input: "\u{0021}\u{202C}\u{202A}\u{2067}",
    direction: None,
    expected_levels: [0, -1, -1, 0],
    expected_reorder: [0, 3],
  },
]

///|
test "BidiTest.txt part 216" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
