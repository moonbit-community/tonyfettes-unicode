    input: "\u{202E}\u{002B}\u{202D}\u{0061}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 193991,
    input: "\u{202E}\u{002B}\u{202D}\u{05D0}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 193992,
    input: "\u{202E}\u{002B}\u{202D}\u{0627}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 193993,
    input: "\u{202E}\u{002B}\u{202D}\u{0030}",
    direction: None,
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 193994,
    input: "\u{202E}\u{002B}\u{202D}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 193995,
    input: "\u{202E}\u{002B}\u{202D}\u{002B}",
    direction: None,
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 193996,
    input: "\u{202E}\u{002B}\u{202D}\u{002B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 193997,
    input: "\u{202E}\u{002B}\u{202D}\u{0024}",
    direction: None,
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 193998,
    input: "\u{202E}\u{002B}\u{202D}\u{0024}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 193999,
    input: "\u{202E}\u{002B}\u{202D}\u{0660}",
    direction: None,
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
]

///|
test "BidiTest.txt part 387" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
