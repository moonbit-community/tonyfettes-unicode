    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79989,
    input: "\u{0020}\u{2069}\u{202D}\u{202D}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79990,
    input: "\u{0020}\u{2069}\u{202D}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79991,
    input: "\u{0020}\u{2069}\u{202D}\u{202B}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79992,
    input: "\u{0020}\u{2069}\u{202D}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79993,
    input: "\u{0020}\u{2069}\u{202D}\u{202E}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79994,
    input: "\u{0020}\u{2069}\u{202D}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79995,
    input: "\u{0020}\u{2069}\u{202D}\u{202C}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79996,
    input: "\u{0020}\u{2069}\u{202D}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79997,
    input: "\u{0020}\u{2069}\u{202D}\u{200B}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79998,
    input: "\u{0020}\u{2069}\u{202D}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 79999,
    input: "\u{0020}\u{2069}\u{202B}\u{202A}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
]

///|
test "BidiTest.txt part 159" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
