    expected_reorder: [3],
  },
  {
    number: 65989,
    input: "\u{202C}\u{202A}\u{202B}\u{0660}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
  {
    number: 65990,
    input: "\u{202C}\u{202A}\u{202B}\u{0660}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
  {
    number: 65991,
    input: "\u{202C}\u{202A}\u{200B}\u{0660}",
    direction: None,
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
  {
    number: 65992,
    input: "\u{202C}\u{202A}\u{200B}\u{0660}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
  {
    number: 65993,
    input: "\u{202C}\u{202A}\u{200B}\u{0660}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
  {
    number: 65994,
    input: "\u{202C}\u{202D}\u{202A}\u{0061}",
    direction: None,
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
  {
    number: 65995,
    input: "\u{202C}\u{202D}\u{202A}\u{0061}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
  {
    number: 65996,
    input: "\u{202C}\u{202D}\u{202A}\u{0061}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
  {
    number: 65997,
    input: "\u{202C}\u{202D}\u{202A}\u{0030}",
    direction: None,
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
  {
    number: 65998,
    input: "\u{202C}\u{202D}\u{202A}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
  {
    number: 65999,
    input: "\u{202C}\u{202D}\u{202A}\u{0030}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, 4],
    expected_reorder: [3],
  },
]

///|
test "BidiTest.txt part 131" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
