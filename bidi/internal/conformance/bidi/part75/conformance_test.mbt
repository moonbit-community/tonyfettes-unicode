    input: "\u{0300}\u{0300}\u{0300}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [1, 1, 1, -1],
    expected_reorder: [2, 1, 0],
  },
  {
    number: 379996,
    input: "\u{0300}\u{0300}\u{0300}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [1, 1, 1, -1],
    expected_reorder: [2, 1, 0],
  },
  {
    number: 379997,
    input: "\u{0300}\u{0300}\u{0300}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [1, 1, 1, -1],
    expected_reorder: [2, 1, 0],
  },
  {
    number: 379998,
    input: "\u{0300}\u{0300}\u{0300}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [1, 1, 1, -1],
    expected_reorder: [2, 1, 0],
  },
  {
    number: 379999,
    input: "\u{0300}\u{0300}\u{0300}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [1, 1, 1, -1],
    expected_reorder: [2, 1, 0],
  },
]

///|
test "BidiTest.txt part 75" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
