    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 337488,
    input: "\u{2066}\u{202A}\u{2066}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 337489,
    input: "\u{2066}\u{202A}\u{2066}\u{2066}",
    direction: None,
    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 337490,
    input: "\u{2066}\u{202A}\u{2066}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 0, 0],
    expected_reorder: [0, 2, 3],
  },
  {
