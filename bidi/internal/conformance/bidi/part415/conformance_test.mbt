    number: 207989,
    input: "\u{200B}\u{0660}\u{200B}\u{0009}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207990,
    input: "\u{200B}\u{0660}\u{200B}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207991,
    input: "\u{200B}\u{0660}\u{200B}\u{0020}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207992,
    input: "\u{200B}\u{0660}\u{200B}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207993,
    input: "\u{200B}\u{0660}\u{200B}\u{0021}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207994,
    input: "\u{200B}\u{0660}\u{200B}\u{0021}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207995,
    input: "\u{200B}\u{0660}\u{200B}\u{2066}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207996,
    input: "\u{200B}\u{0660}\u{200B}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207997,
    input: "\u{200B}\u{0660}\u{200B}\u{2067}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207998,
    input: "\u{200B}\u{0660}\u{200B}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207999,
    input: "\u{200B}\u{0660}\u{200B}\u{2068}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 415" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
