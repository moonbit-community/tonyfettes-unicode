    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186988,
    input: "\u{202B}\u{2068}\u{002C}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186989,
    input: "\u{202B}\u{2068}\u{002C}\u{202C}",
    direction: None,
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186990,
    input: "\u{202B}\u{2068}\u{002C}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186991,
    input: "\u{202B}\u{2068}\u{002C}\u{200B}",
    direction: None,
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186992,
    input: "\u{202B}\u{2068}\u{002C}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186993,
    input: "\u{202B}\u{2068}\u{0300}\u{202A}",
    direction: None,
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186994,
    input: "\u{202B}\u{2068}\u{0300}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186995,
    input: "\u{202B}\u{2068}\u{0300}\u{202D}",
    direction: None,
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186996,
    input: "\u{202B}\u{2068}\u{0300}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186997,
    input: "\u{202B}\u{2068}\u{0300}\u{202B}",
    direction: None,
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186998,
    input: "\u{202B}\u{2068}\u{0300}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 186999,
    input: "\u{202B}\u{2068}\u{0300}\u{202E}",
    direction: None,
    expected_levels: [-1, 1, 2, -1],
    expected_reorder: [2, 1],
  },
]

///|
test "BidiTest.txt part 373" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
