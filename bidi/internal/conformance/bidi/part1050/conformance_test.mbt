    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525489,
    input: "\u{202C}\u{0660}\u{0009}\u{002C}",
    direction: None,
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525490,
    input: "\u{202C}\u{0660}\u{0009}\u{002C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525491,
    input: "\u{202C}\u{0660}\u{0009}\u{0300}",
    direction: None,
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525492,
    input: "\u{202C}\u{0660}\u{0009}\u{0300}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525493,
    input: "\u{202C}\u{0660}\u{0009}\u{000A}",
    direction: None,
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525494,
    input: "\u{202C}\u{0660}\u{0009}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525495,
    input: "\u{202C}\u{0660}\u{0009}\u{0009}",
    direction: None,
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525496,
    input: "\u{202C}\u{0660}\u{0009}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525497,
    input: "\u{202C}\u{0660}\u{0009}\u{0020}",
    direction: None,
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525498,
    input: "\u{202C}\u{0660}\u{0009}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 525499,
    input: "\u{202C}\u{0660}\u{0009}\u{0021}",
    direction: None,
    expected_levels: [-1, 2, 0, 0],
    expected_reorder: [1, 2, 3],
  },
]

///|
test "BidiTest.txt part 1050" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
