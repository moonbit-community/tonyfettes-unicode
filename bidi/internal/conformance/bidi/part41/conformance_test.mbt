    input: "\u{2067}\u{202C}\u{202B}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 20991,
    input: "\u{2067}\u{202C}\u{202E}\u{202A}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 20992,
    input: "\u{2067}\u{202C}\u{202E}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 20993,
    input: "\u{2067}\u{202C}\u{202E}\u{202D}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 20994,
    input: "\u{2067}\u{202C}\u{202E}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 20995,
    input: "\u{2067}\u{202C}\u{202E}\u{202B}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 20996,
    input: "\u{2067}\u{202C}\u{202E}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 20997,
    input: "\u{2067}\u{202C}\u{202E}\u{202E}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 20998,
    input: "\u{2067}\u{202C}\u{202E}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 20999,
    input: "\u{2067}\u{202C}\u{202E}\u{202C}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
]

///|
test "BidiTest.txt part 41" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
