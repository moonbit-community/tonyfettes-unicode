    expected_reorder: [0, 1],
  },
  {
    number: 158993,
    input: "\u{0061}\u{0660}\u{202D}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 2, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 158994,
    input: "\u{0061}\u{0660}\u{202D}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 2, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 158995,
    input: "\u{0061}\u{0660}\u{202B}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 2, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 158996,
    input: "\u{0061}\u{0660}\u{202B}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 2, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 158997,
    input: "\u{0061}\u{0660}\u{202B}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 2, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 158998,
    input: "\u{0061}\u{0660}\u{202B}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 2, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 158999,
    input: "\u{0061}\u{0660}\u{202B}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 2, -1, -1],
    expected_reorder: [0, 1],
  },
]

///|
test "BidiTest.txt part 317" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
