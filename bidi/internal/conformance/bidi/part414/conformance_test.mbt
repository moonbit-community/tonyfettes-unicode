    input: "\u{202D}\u{2069}\u{202C}\u{0061}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207493,
    input: "\u{202D}\u{2069}\u{202C}\u{0030}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207494,
    input: "\u{202D}\u{2069}\u{202C}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207495,
    input: "\u{202D}\u{2069}\u{202C}\u{002B}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207496,
    input: "\u{202D}\u{2069}\u{202C}\u{002B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207497,
    input: "\u{202D}\u{2069}\u{202C}\u{0024}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207498,
    input: "\u{202D}\u{2069}\u{202C}\u{0024}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 207499,
    input: "\u{202D}\u{2069}\u{202C}\u{002C}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 414" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
