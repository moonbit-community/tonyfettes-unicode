    input: "\u{202A}\u{0300}\u{0009}\u{202B}",
    direction: None,
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 197990,
    input: "\u{202A}\u{0300}\u{0009}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 197991,
    input: "\u{202A}\u{0300}\u{0009}\u{202E}",
    direction: None,
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 197992,
    input: "\u{202A}\u{0300}\u{0009}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 197993,
    input: "\u{202A}\u{0300}\u{0009}\u{202C}",
    direction: None,
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 197994,
    input: "\u{202A}\u{0300}\u{0009}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 197995,
    input: "\u{202A}\u{0300}\u{0009}\u{200B}",
    direction: None,
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 197996,
    input: "\u{202A}\u{0300}\u{0009}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 197997,
    input: "\u{202A}\u{0300}\u{0020}\u{202A}",
    direction: None,
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 197998,
    input: "\u{202A}\u{0300}\u{0020}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 197999,
    input: "\u{202A}\u{0300}\u{0020}\u{202D}",
    direction: None,
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
]

///|
test "BidiTest.txt part 395" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
