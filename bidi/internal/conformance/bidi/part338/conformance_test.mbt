    input: "\u{200B}\u{002B}\u{0030}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169493,
    input: "\u{200B}\u{002B}\u{0030}\u{202D}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169494,
    input: "\u{200B}\u{002B}\u{0030}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169495,
    input: "\u{200B}\u{002B}\u{0030}\u{202B}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169496,
    input: "\u{200B}\u{002B}\u{0030}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169497,
    input: "\u{200B}\u{002B}\u{0030}\u{202E}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169498,
    input: "\u{200B}\u{002B}\u{0030}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
  {
    number: 169499,
    input: "\u{200B}\u{002B}\u{0030}\u{202C}",
    direction: None,
    expected_levels: [-1, 0, 0, -1],
    expected_reorder: [1, 2],
  },
]

///|
test "BidiTest.txt part 338" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
