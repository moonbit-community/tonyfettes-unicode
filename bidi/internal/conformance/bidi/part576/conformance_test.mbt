    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 288489,
    input: "\u{0020}\u{0020}\u{202C}\u{0009}",
    direction: None,
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 288490,
    input: "\u{0020}\u{0020}\u{202C}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 288491,
    input: "\u{0020}\u{0020}\u{202C}\u{0020}",
    direction: None,
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 288492,
    input: "\u{0020}\u{0020}\u{202C}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 288493,
    input: "\u{0020}\u{0020}\u{202C}\u{0021}",
    direction: None,
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 288494,
    input: "\u{0020}\u{0020}\u{202C}\u{0021}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 288495,
    input: "\u{0020}\u{0020}\u{202C}\u{2066}",
    direction: None,
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 288496,
    input: "\u{0020}\u{0020}\u{202C}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 0],
