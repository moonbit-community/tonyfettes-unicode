    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 539994,
    input: "\u{202D}\u{0021}\u{0021}\u{0061}",
    direction: None,
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 539995,
    input: "\u{202D}\u{0021}\u{0021}\u{0061}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 539996,
    input: "\u{202D}\u{0021}\u{0021}\u{0061}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 539997,
    input: "\u{202D}\u{0021}\u{0021}\u{05D0}",
    direction: None,
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 539998,
    input: "\u{202D}\u{0021}\u{0021}\u{05D0}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 539999,
    input: "\u{202D}\u{0021}\u{0021}\u{05D0}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
]

///|
test "BidiTest.txt part 107" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
