    input: "\u{0030}\u{2066}\u{200B}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 280489,
    input: "\u{0030}\u{2066}\u{200B}\u{2067}",
    direction: None,
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 280490,
    input: "\u{0030}\u{2066}\u{200B}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
