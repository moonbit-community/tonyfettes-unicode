    expected_levels: [-1, -1, 1, 1],
    expected_reorder: [3, 2],
  },
  {
    number: 229993,
    input: "\u{202A}\u{202C}\u{002B}\u{002C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, 1],
    expected_reorder: [3, 2],
  },
  {
    number: 229994,
    input: "\u{202A}\u{202C}\u{002B}\u{0300}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, 1],
    expected_reorder: [3, 2],
  },
  {
    number: 229995,
    input: "\u{202A}\u{202C}\u{002B}\u{000A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, 1],
    expected_reorder: [3, 2],
  },
  {
    number: 229996,
    input: "\u{202A}\u{202C}\u{002B}\u{0009}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, 1],
    expected_reorder: [3, 2],
  },
  {
    number: 229997,
    input: "\u{202A}\u{202C}\u{002B}\u{0020}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, 1],
    expected_reorder: [3, 2],
  },
  {
    number: 229998,
    input: "\u{202A}\u{202C}\u{002B}\u{0021}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, 1],
    expected_reorder: [3, 2],
  },
  {
    number: 229999,
    input: "\u{202A}\u{202C}\u{002B}\u{2066}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, 1],
    expected_reorder: [3, 2],
  },
]

///|
test "BidiTest.txt part 45" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
