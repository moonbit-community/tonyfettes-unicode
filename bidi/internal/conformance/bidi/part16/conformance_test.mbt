    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8494,
    input: "\u{202D}\u{202B}\u{200B}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8495,
    input: "\u{202D}\u{202B}\u{200B}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8496,
    input: "\u{202D}\u{202B}\u{200B}\u{200B}",
    direction: None,
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8497,
    input: "\u{202D}\u{202B}\u{200B}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8498,
    input: "\u{202D}\u{202B}\u{200B}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 8499,
    input: "\u{202D}\u{202E}\u{202A}\u{202A}",
    direction: None,
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
]

///|
test "BidiTest.txt part 16" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
