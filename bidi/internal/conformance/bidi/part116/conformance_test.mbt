    expected_reorder: [0, 1, 2, 3],
  },
  {
    number: 584994,
    input: "\u{0009}\u{2068}\u{0020}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3],
  },
  {
    number: 584995,
    input: "\u{0009}\u{2068}\u{0020}\u{0020}",
    direction: None,
    expected_levels: [0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3],
  },
  {
    number: 584996,
    input: "\u{0009}\u{2068}\u{0020}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3],
  },
  {
    number: 584997,
    input: "\u{0009}\u{2068}\u{0020}\u{2066}",
    direction: None,
    expected_levels: [0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3],
  },
  {
    number: 584998,
    input: "\u{0009}\u{2068}\u{0020}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3],
  },
  {
    number: 584999,
    input: "\u{0009}\u{2068}\u{0020}\u{2067}",
    direction: None,
    expected_levels: [0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3],
  },
]

///|
test "BidiTest.txt part 116" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
