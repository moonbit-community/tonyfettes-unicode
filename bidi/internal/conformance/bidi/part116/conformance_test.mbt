    expected_levels: [-1, -1, -1, 0],
    expected_reorder: [3],
  },
  {
    number: 58497,
    input: "\u{202B}\u{200B}\u{202B}\u{2068}",
    direction: None,
    expected_levels: [-1, -1, -1, 0],
    expected_reorder: [3],
  },
  {
    number: 58498,
    input: "\u{202B}\u{200B}\u{202B}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, 0],
    expected_reorder: [3],
  },
  {
    number: 58499,
    input: "\u{202B}\u{200B}\u{202B}\u{2069}",
    direction: None,
    expected_levels: [-1, -1, -1, 0],
    expected_reorder: [3],
  },
]

///|
test "BidiTest.txt part 116" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
