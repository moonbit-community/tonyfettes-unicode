    input: "\u{202C}\u{0024}\u{202A}\u{0030}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 194489,
    input: "\u{202C}\u{0024}\u{202A}\u{002B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 194490,
    input: "\u{202C}\u{0024}\u{202A}\u{0024}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 194491,
    input: "\u{202C}\u{0024}\u{202A}\u{002C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 194492,
    input: "\u{202C}\u{0024}\u{202A}\u{0300}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 194493,
    input: "\u{202C}\u{0024}\u{202A}\u{0021}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 194494,
    input: "\u{202C}\u{0024}\u{202D}\u{0061}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 194495,
    input: "\u{202C}\u{0024}\u{202D}\u{05D0}",
    direction: None,
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 194496,
    input: "\u{202C}\u{0024}\u{202D}\u{05D0}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 2],
    expected_reorder: [3, 1],
  },
  {
    number: 194497,
