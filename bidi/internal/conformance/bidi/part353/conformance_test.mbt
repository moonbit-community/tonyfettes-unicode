  {
    number: 176991,
    input: "\u{200B}\u{0021}\u{202C}\u{002B}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 176992,
    input: "\u{200B}\u{0021}\u{202C}\u{002B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 176993,
    input: "\u{200B}\u{0021}\u{202C}\u{0024}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 176994,
    input: "\u{200B}\u{0021}\u{202C}\u{0024}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 176995,
    input: "\u{200B}\u{0021}\u{202C}\u{002C}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 176996,
    input: "\u{200B}\u{0021}\u{202C}\u{002C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 176997,
    input: "\u{200B}\u{0021}\u{202C}\u{0300}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 176998,
    input: "\u{200B}\u{0021}\u{202C}\u{0300}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 176999,
    input: "\u{200B}\u{0021}\u{202C}\u{000A}",
    direction: None,
    expected_levels: [-1, 0, -1, 0],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 353" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
