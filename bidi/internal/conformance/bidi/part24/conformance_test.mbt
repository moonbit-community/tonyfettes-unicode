    expected_levels: [1, 1, -1, -1],
    expected_reorder: [1, 0],
  },
  {
    number: 124992,
    input: "\u{0627}\u{2069}\u{202E}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [1, 1, -1, -1],
    expected_reorder: [1, 0],
  },
  {
    number: 124993,
    input: "\u{0627}\u{2069}\u{202E}\u{202E}",
    direction: None,
    expected_levels: [1, 1, -1, -1],
    expected_reorder: [1, 0],
  },
  {
    number: 124994,
    input: "\u{0627}\u{2069}\u{202E}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [1, 1, -1, -1],
    expected_reorder: [1, 0],
  },
  {
    number: 124995,
    input: "\u{0627}\u{2069}\u{202E}\u{202C}",
    direction: None,
    expected_levels: [1, 1, -1, -1],
    expected_reorder: [1, 0],
  },
  {
    number: 124996,
    input: "\u{0627}\u{2069}\u{202E}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [1, 1, -1, -1],
    expected_reorder: [1, 0],
  },
  {
    number: 124997,
    input: "\u{0627}\u{2069}\u{202E}\u{200B}",
    direction: None,
    expected_levels: [1, 1, -1, -1],
    expected_reorder: [1, 0],
  },
  {
    number: 124998,
    input: "\u{0627}\u{2069}\u{202E}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [1, 1, -1, -1],
    expected_reorder: [1, 0],
  },
  {
    number: 124999,
    input: "\u{0627}\u{2069}\u{202C}\u{202A}",
    direction: None,
    expected_levels: [1, 1, -1, -1],
    expected_reorder: [1, 0],
  },
]

///|
test "BidiTest.txt part 24" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
