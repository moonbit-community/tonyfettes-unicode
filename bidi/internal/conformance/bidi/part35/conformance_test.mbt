  {
    number: 17994,
    input: "\u{0024}\u{202C}\u{200B}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 17995,
    input: "\u{0024}\u{202C}\u{200B}\u{202B}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 17996,
    input: "\u{0024}\u{202C}\u{200B}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 17997,
    input: "\u{0024}\u{202C}\u{200B}\u{202E}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 17998,
    input: "\u{0024}\u{202C}\u{200B}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 17999,
    input: "\u{0024}\u{202C}\u{200B}\u{202C}",
    direction: None,
    expected_levels: [0, -1, -1, -1],
    expected_reorder: [0],
  },
]

///|
test "BidiTest.txt part 35" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
