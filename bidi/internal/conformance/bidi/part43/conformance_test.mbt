    expected_reorder: [0, 1],
  },
  {
    number: 21991,
    input: "\u{05D0}\u{0009}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [1, 0, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 21992,
    input: "\u{05D0}\u{0009}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [1, 0, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 21993,
    input: "\u{05D0}\u{0020}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [1, 0, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 21994,
    input: "\u{05D0}\u{0020}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [1, 0, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 21995,
    input: "\u{05D0}\u{0020}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [1, 0, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 21996,
    input: "\u{05D0}\u{0020}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [1, 0, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 21997,
    input: "\u{05D0}\u{0020}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [1, 0, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 21998,
    input: "\u{05D0}\u{0020}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [1, 0, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 21999,
    input: "\u{05D0}\u{0021}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [1, 0, -1],
    expected_reorder: [0, 1],
  },
]

///|
test "BidiTest.txt part 43" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
