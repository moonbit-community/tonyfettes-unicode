    input: "\u{0660}\u{202B}\u{200B}\u{0300}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, -1, -1, 3],
    expected_reorder: [0, 3],
  },
  {
    number: 164996,
    input: "\u{0660}\u{202B}\u{200B}\u{0021}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, -1, -1, 3],
    expected_reorder: [0, 3],
  },
  {
    number: 164997,
    input: "\u{0660}\u{202E}\u{202A}\u{05D0}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [2, -1, -1, 3],
    expected_reorder: [0, 3],
  },
  {
    number: 164998,
    input: "\u{0660}\u{202E}\u{202A}\u{0627}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [2, -1, -1, 3],
    expected_reorder: [0, 3],
  },
  {
    number: 164999,
    input: "\u{0660}\u{202E}\u{202B}\u{05D0}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [2, -1, -1, 3],
    expected_reorder: [0, 3],
  },
]

///|
test "BidiTest.txt part 32" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
