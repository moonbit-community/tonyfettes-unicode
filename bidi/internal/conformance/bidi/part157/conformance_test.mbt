    number: 78988,
    input: "\u{0009}\u{2068}\u{202D}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 78989,
    input: "\u{0009}\u{2068}\u{202D}\u{200B}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
