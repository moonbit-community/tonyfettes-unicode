    expected_reorder: [1, 3],
  },
  {
    number: 206492,
    input: "\u{202A}\u{0021}\u{202A}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 206493,
    input: "\u{202A}\u{0021}\u{202A}\u{2068}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 206494,
    input: "\u{202A}\u{0021}\u{202A}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 206495,
    input: "\u{202A}\u{0021}\u{202A}\u{2069}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 206496,
    input: "\u{202A}\u{0021}\u{202A}\u{2069}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 206497,
    input: "\u{202A}\u{0021}\u{202D}\u{000A}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 206498,
    input: "\u{202A}\u{0021}\u{202D}\u{000A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 206499,
    input: "\u{202A}\u{0021}\u{202D}\u{0009}",
    direction: None,
    expected_levels: [-1, 2, -1, 0],
    expected_reorder: [1, 3],
  },
]

///|
test "BidiTest.txt part 412" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
