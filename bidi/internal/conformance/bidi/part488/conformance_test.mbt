    expected_reorder: [3, 2],
  },
  {
    number: 244486,
    input: "\u{202E}\u{202E}\u{2069}\u{0300}",
    direction: None,
    expected_levels: [-1, -1, 3, 3],
    expected_reorder: [3, 2],
  },
  {
    number: 244487,
    input: "\u{202E}\u{202E}\u{2069}\u{0300}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 3, 3],
    expected_reorder: [3, 2],
