    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 265989,
    input: "\u{0020}\u{2067}\u{0020}\u{202E}",
    direction: None,
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
