    input: "\u{2066}\u{202E}\u{2066}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 0, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 94493,
    input: "\u{2066}\u{202E}\u{2066}\u{200B}",
    direction: None,
    expected_levels: [0, -1, 0, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 94494,
    input: "\u{2066}\u{202E}\u{2066}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 0, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 94495,
    input: "\u{2066}\u{202E}\u{2067}\u{202A}",
    direction: None,
    expected_levels: [0, -1, 0, -1],
    expected_reorder: [0, 2],
  },
  {
