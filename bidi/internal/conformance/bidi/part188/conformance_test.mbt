    input: "\u{2066}\u{202E}\u{2066}\u{202B}",
    direction: None,
    expected_levels: [0, -1, 0, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 94488,
    input: "\u{2066}\u{202E}\u{2066}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 0, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 94489,
    input: "\u{2066}\u{202E}\u{2066}\u{202E}",
    direction: None,
    expected_levels: [0, -1, 0, -1],
    expected_reorder: [0, 2],
  },
  {
    number: 94490,
    input: "\u{2066}\u{202E}\u{2066}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 0, -1],
    expected_reorder: [0, 2],
  },
  {
