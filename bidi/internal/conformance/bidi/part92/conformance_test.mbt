  },
  {
    number: 46489,
    input: "\u{202B}\u{0030}\u{202D}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 46490,
    input: "\u{202B}\u{0030}\u{202D}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 46491,
    input: "\u{202B}\u{0030}\u{202B}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 46492,
    input: "\u{202B}\u{0030}\u{202B}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 46493,
    input: "\u{202B}\u{0030}\u{202B}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 46494,
    input: "\u{202B}\u{0030}\u{202B}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 46495,
    input: "\u{202B}\u{0030}\u{202B}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 46496,
    input: "\u{202B}\u{0030}\u{202B}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 46497,
    input: "\u{202B}\u{0030}\u{202E}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 46498,
    input: "\u{202B}\u{0030}\u{202E}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
  {
    number: 46499,
    input: "\u{202B}\u{0030}\u{202E}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, -1, -1],
    expected_reorder: [1],
  },
]

///|
test "BidiTest.txt part 92" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
