    input: "\u{2067}\u{202A}\u{002C}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 2, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 354997,
    input: "\u{2067}\u{202A}\u{002C}\u{2068}",
    direction: None,
    expected_levels: [0, -1, 2, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 354998,
    input: "\u{2067}\u{202A}\u{002C}\u{2068}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, -1, 2, 0],
    expected_reorder: [0, 2, 3],
  },
  {
    number: 354999,
    input: "\u{2067}\u{202A}\u{002C}\u{2069}",
    direction: None,
    expected_levels: [0, -1, 2, 0],
    expected_reorder: [0, 2, 3],
  },
]

///|
test "BidiTest.txt part 70" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
