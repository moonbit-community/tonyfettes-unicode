    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 287489,
    input: "\u{0009}\u{2068}\u{202E}\u{2067}",
    direction: None,
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 287490,
    input: "\u{0009}\u{2068}\u{202E}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, 0],
    expected_reorder: [0, 1, 3],
  },
