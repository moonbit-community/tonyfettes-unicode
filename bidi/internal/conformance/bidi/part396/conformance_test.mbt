  },
  {
    number: 198490,
    input: "\u{202D}\u{0660}\u{0009}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 0, -1],
    expected_reorder: [1, 2],
  },
