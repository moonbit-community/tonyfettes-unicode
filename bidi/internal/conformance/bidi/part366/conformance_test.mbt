    input: "\u{202E}\u{002C}\u{0021}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183489,
    input: "\u{202E}\u{002C}\u{0021}\u{202E}",
    direction: None,
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183490,
    input: "\u{202E}\u{002C}\u{0021}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183491,
    input: "\u{202E}\u{002C}\u{0021}\u{202C}",
    direction: None,
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183492,
    input: "\u{202E}\u{002C}\u{0021}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183493,
    input: "\u{202E}\u{002C}\u{0021}\u{200B}",
    direction: None,
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183494,
    input: "\u{202E}\u{002C}\u{0021}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183495,
    input: "\u{202E}\u{0300}\u{0061}\u{202A}",
    direction: None,
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183496,
    input: "\u{202E}\u{0300}\u{0061}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183497,
    input: "\u{202E}\u{0300}\u{0061}\u{202D}",
    direction: None,
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183498,
    input: "\u{202E}\u{0300}\u{0061}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
  {
    number: 183499,
    input: "\u{202E}\u{0300}\u{0061}\u{202B}",
    direction: None,
    expected_levels: [-1, 1, 1, -1],
    expected_reorder: [2, 1],
  },
]

///|
test "BidiTest.txt part 366" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
