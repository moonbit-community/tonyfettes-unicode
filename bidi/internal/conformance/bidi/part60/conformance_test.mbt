    expected_reorder: [0],
  },
  {
    number: 30490,
    input: "\u{0030}\u{202D}\u{200B}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 30491,
    input: "\u{0030}\u{202D}\u{200B}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 30492,
    input: "\u{0030}\u{202D}\u{200B}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 30493,
    input: "\u{0030}\u{202D}\u{200B}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 30494,
    input: "\u{0030}\u{202D}\u{200B}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 30495,
    input: "\u{0030}\u{202B}\u{202A}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 30496,
    input: "\u{0030}\u{202B}\u{202A}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, -1, -1, -1],
    expected_reorder: [0],
  },
  {
    number: 30497,
    input: "\u{0030}\u{202B}\u{202A}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, -1, -1, -1],
