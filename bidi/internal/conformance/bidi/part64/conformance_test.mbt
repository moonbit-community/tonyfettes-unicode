    direction: None,
    expected_levels: [0, 2, -1, 3],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 324990,
    input: "\u{2066}\u{002B}\u{202E}\u{0061}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 2, -1, 3],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 324991,
    input: "\u{2066}\u{002B}\u{202E}\u{05D0}",
    direction: None,
    expected_levels: [0, 2, -1, 3],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 324992,
    input: "\u{2066}\u{002B}\u{202E}\u{05D0}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 2, -1, 3],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 324993,
    input: "\u{2066}\u{002B}\u{202E}\u{0627}",
    direction: None,
    expected_levels: [0, 2, -1, 3],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 324994,
    input: "\u{2066}\u{002B}\u{202E}\u{0627}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 2, -1, 3],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 324995,
    input: "\u{2066}\u{002B}\u{202E}\u{0030}",
    direction: None,
    expected_levels: [0, 2, -1, 3],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 324996,
    input: "\u{2066}\u{002B}\u{202E}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 2, -1, 3],
    expected_reorder: [0, 1, 3],
  },
  {
    number: 324997,
