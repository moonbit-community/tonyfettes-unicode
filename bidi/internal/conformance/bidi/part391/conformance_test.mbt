    number: 195987,
    input: "\u{202C}\u{05D0}\u{202E}\u{0660}",
    direction: None,
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195988,
    input: "\u{202C}\u{05D0}\u{202E}\u{0660}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195989,
    input: "\u{202C}\u{05D0}\u{202E}\u{002C}",
    direction: None,
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195990,
    input: "\u{202C}\u{05D0}\u{202E}\u{002C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195991,
    input: "\u{202C}\u{05D0}\u{202E}\u{0300}",
    direction: None,
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195992,
    input: "\u{202C}\u{05D0}\u{202E}\u{0300}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195993,
    input: "\u{202C}\u{05D0}\u{202E}\u{0021}",
    direction: None,
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195994,
    input: "\u{202C}\u{05D0}\u{202E}\u{0021}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195995,
    input: "\u{202C}\u{0627}\u{202A}\u{05D0}",
    direction: None,
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195996,
    input: "\u{202C}\u{0627}\u{202A}\u{05D0}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195997,
    input: "\u{202C}\u{0627}\u{202A}\u{05D0}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195998,
    input: "\u{202C}\u{0627}\u{202A}\u{0627}",
    direction: None,
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
  {
    number: 195999,
    input: "\u{202C}\u{0627}\u{202A}\u{0627}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 3],
    expected_reorder: [3, 1],
  },
]

///|
test "BidiTest.txt part 391" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
