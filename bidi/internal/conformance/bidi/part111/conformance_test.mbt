    input: "\u{202A}\u{0660}\u{0627}\u{0300}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 4, 3, 3],
    expected_reorder: [3, 2, 1],
  },
  {
    number: 559992,
    input: "\u{202A}\u{0660}\u{0627}\u{0300}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, 3, 3],
    expected_reorder: [3, 2, 1],
  },
  {
    number: 559993,
    input: "\u{202A}\u{0660}\u{002B}\u{05D0}",
    direction: None,
    expected_levels: [-1, 4, 3, 3],
    expected_reorder: [3, 2, 1],
  },
  {
    number: 559994,
    input: "\u{202A}\u{0660}\u{002B}\u{05D0}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 4, 3, 3],
    expected_reorder: [3, 2, 1],
  },
  {
    number: 559995,
    input: "\u{202A}\u{0660}\u{002B}\u{05D0}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, 3, 3],
    expected_reorder: [3, 2, 1],
  },
  {
    number: 559996,
    input: "\u{202A}\u{0660}\u{002B}\u{0627}",
    direction: None,
    expected_levels: [-1, 4, 3, 3],
    expected_reorder: [3, 2, 1],
  },
  {
    number: 559997,
    input: "\u{202A}\u{0660}\u{002B}\u{0627}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 4, 3, 3],
    expected_reorder: [3, 2, 1],
  },
  {
    number: 559998,
    input: "\u{202A}\u{0660}\u{002B}\u{0627}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 4, 3, 3],
    expected_reorder: [3, 2, 1],
  },
  {
    number: 559999,
    input: "\u{202A}\u{0660}\u{0024}\u{05D0}",
    direction: None,
    expected_levels: [-1, 4, 3, 3],
    expected_reorder: [3, 2, 1],
  },
]

///|
test "BidiTest.txt part 111" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
