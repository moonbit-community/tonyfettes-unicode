    input: "\u{202A}\u{202C}\u{0627}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 1, -1],
    expected_reorder: [2],
  },
  {
    number: 49991,
    input: "\u{202A}\u{202C}\u{0627}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, -1],
    expected_reorder: [2],
  },
  {
    number: 49992,
    input: "\u{202A}\u{202C}\u{0627}\u{200B}",
    direction: None,
    expected_levels: [-1, -1, 1, -1],
    expected_reorder: [2],
  },
  {
    number: 49993,
    input: "\u{202A}\u{202C}\u{0627}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 1, -1],
    expected_reorder: [2],
  },
  {
    number: 49994,
    input: "\u{202A}\u{202C}\u{0627}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, -1],
    expected_reorder: [2],
  },
  {
    number: 49995,
    input: "\u{202A}\u{202C}\u{002B}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, -1],
    expected_reorder: [2],
  },
  {
    number: 49996,
    input: "\u{202A}\u{202C}\u{002B}\u{202D}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, -1],
    expected_reorder: [2],
  },
  {
    number: 49997,
    input: "\u{202A}\u{202C}\u{002B}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, -1],
    expected_reorder: [2],
  },
  {
    number: 49998,
    input: "\u{202A}\u{202C}\u{002B}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, -1],
    expected_reorder: [2],
  },
  {
    number: 49999,
    input: "\u{202A}\u{202C}\u{002B}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 1, -1],
    expected_reorder: [2],
  },
]

///|
test "BidiTest.txt part 99" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
