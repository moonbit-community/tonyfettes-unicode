    direction: Some(@bidi.Direction::LTR),
    expected_levels: [2, 1, 1, 2],
    expected_reorder: [3, 2, 1, 0],
  },
  {
    number: 759994,
    input: "\u{0660}\u{2069}\u{002B}\u{0660}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 1, 1, 2],
    expected_reorder: [3, 2, 1, 0],
  },
  {
    number: 759995,
    input: "\u{0660}\u{2069}\u{0024}\u{0061}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 1, 1, 2],
    expected_reorder: [3, 2, 1, 0],
  },
  {
    number: 759996,
    input: "\u{0660}\u{2069}\u{0024}\u{0660}",
    direction: None,
    expected_levels: [2, 1, 1, 2],
    expected_reorder: [3, 2, 1, 0],
  },
  {
    number: 759997,
    input: "\u{0660}\u{2069}\u{0024}\u{0660}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [2, 1, 1, 2],
    expected_reorder: [3, 2, 1, 0],
  },
  {
    number: 759998,
    input: "\u{0660}\u{2069}\u{0024}\u{0660}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 1, 1, 2],
    expected_reorder: [3, 2, 1, 0],
  },
  {
    number: 759999,
    input: "\u{0660}\u{2069}\u{002C}\u{0061}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [2, 1, 1, 2],
    expected_reorder: [3, 2, 1, 0],
  },
]

///|
test "BidiTest.txt part 151" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
