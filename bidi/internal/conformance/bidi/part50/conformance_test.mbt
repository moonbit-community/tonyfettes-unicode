    input: "\u{0030}\u{0020}\u{0300}\u{202D}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 254995,
    input: "\u{0030}\u{0020}\u{0300}\u{202B}",
    direction: None,
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 254996,
    input: "\u{0030}\u{0020}\u{0300}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 254997,
    input: "\u{0030}\u{0020}\u{0300}\u{202E}",
    direction: None,
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 254998,
    input: "\u{0030}\u{0020}\u{0300}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
  {
    number: 254999,
    input: "\u{0030}\u{0020}\u{0300}\u{202C}",
    direction: None,
    expected_levels: [0, 0, 0, -1],
    expected_reorder: [0, 1, 2],
  },
]

///|
test "BidiTest.txt part 50" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
