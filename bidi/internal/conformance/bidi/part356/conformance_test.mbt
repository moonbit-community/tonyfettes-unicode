    expected_reorder: [1, 3],
  },
  {
    number: 178490,
    input: "\u{202C}\u{0024}\u{202D}\u{0021}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178491,
    input: "\u{202C}\u{0024}\u{202B}\u{0061}",
    direction: None,
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178492,
    input: "\u{202C}\u{0024}\u{202B}\u{0061}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178493,
    input: "\u{202C}\u{0024}\u{202B}\u{0030}",
    direction: None,
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178494,
    input: "\u{202C}\u{0024}\u{202B}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
    number: 178495,
    input: "\u{202C}\u{0024}\u{202B}\u{0660}",
    direction: None,
    expected_levels: [-1, 0, -1, 2],
    expected_reorder: [1, 3],
  },
  {
