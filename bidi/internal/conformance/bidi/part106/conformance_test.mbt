    number: 534984,
    input: "\u{202A}\u{0024}\u{002C}\u{0030}",
    direction: None,
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534985,
    input: "\u{202A}\u{0024}\u{002C}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534986,
    input: "\u{202A}\u{0024}\u{002C}\u{0030}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534987,
    input: "\u{202A}\u{0024}\u{002C}\u{002B}",
    direction: None,
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534988,
    input: "\u{202A}\u{0024}\u{002C}\u{002B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534989,
    input: "\u{202A}\u{0024}\u{002C}\u{002B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534990,
    input: "\u{202A}\u{0024}\u{002C}\u{0024}",
    direction: None,
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534991,
    input: "\u{202A}\u{0024}\u{002C}\u{0024}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534992,
    input: "\u{202A}\u{0024}\u{002C}\u{0024}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534993,
    input: "\u{202A}\u{0024}\u{002C}\u{002C}",
    direction: None,
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534994,
    input: "\u{202A}\u{0024}\u{002C}\u{002C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
    number: 534995,
    input: "\u{202A}\u{0024}\u{002C}\u{002C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, 2, 2, 2],
    expected_reorder: [1, 2, 3],
  },
  {
