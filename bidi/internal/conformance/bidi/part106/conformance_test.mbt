    input: "\u{200B}\u{202A}\u{0024}\u{202B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
  {
    number: 53490,
    input: "\u{200B}\u{202A}\u{0024}\u{202E}",
    direction: None,
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
  {
    number: 53491,
    input: "\u{200B}\u{202A}\u{0024}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
  {
    number: 53492,
    input: "\u{200B}\u{202A}\u{0024}\u{202E}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
  {
    number: 53493,
    input: "\u{200B}\u{202A}\u{0024}\u{202C}",
    direction: None,
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
  {
    number: 53494,
    input: "\u{200B}\u{202A}\u{0024}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
  {
    number: 53495,
    input: "\u{200B}\u{202A}\u{0024}\u{202C}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
  {
    number: 53496,
    input: "\u{200B}\u{202A}\u{0024}\u{200B}",
    direction: None,
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
  {
    number: 53497,
    input: "\u{200B}\u{202A}\u{0024}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
  {
    number: 53498,
    input: "\u{200B}\u{202A}\u{0024}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
  {
    number: 53499,
    input: "\u{200B}\u{202A}\u{002C}\u{202A}",
    direction: None,
    expected_levels: [-1, -1, 2, -1],
    expected_reorder: [2],
  },
]

///|
test "BidiTest.txt part 106" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
