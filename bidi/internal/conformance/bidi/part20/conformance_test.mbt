    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 10494,
    input: "\u{202C}\u{202E}\u{202B}\u{200B}",
    direction: None,
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 10495,
    input: "\u{202C}\u{202E}\u{202B}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 10496,
    input: "\u{202C}\u{202E}\u{202B}\u{200B}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 10497,
    input: "\u{202C}\u{202E}\u{202E}\u{202A}",
    direction: None,
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 10498,
    input: "\u{202C}\u{202E}\u{202E}\u{202A}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
  {
    number: 10499,
    input: "\u{202C}\u{202E}\u{202E}\u{202A}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, -1],
    expected_reorder: [],
  },
]

///|
test "BidiTest.txt part 20" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
