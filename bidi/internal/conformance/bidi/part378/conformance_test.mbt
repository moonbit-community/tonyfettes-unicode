    input: "\u{202E}\u{002B}\u{202D}\u{0009}",
    direction: None,
    expected_levels: [-1, 1, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 189490,
    input: "\u{202E}\u{002B}\u{202D}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 189491,
    input: "\u{202E}\u{002B}\u{202D}\u{0020}",
    direction: None,
    expected_levels: [-1, 1, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 189492,
    input: "\u{202E}\u{002B}\u{202D}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 189493,
    input: "\u{202E}\u{002B}\u{202D}\u{2066}",
    direction: None,
    expected_levels: [-1, 1, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 189494,
    input: "\u{202E}\u{002B}\u{202D}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, 1, -1, 0],
    expected_reorder: [1, 3],
  },
  {
    number: 189495,
    input: "\u{202E}\u{002B}\u{202D}\u{2067}",
    direction: None,
    expected_levels: [-1, 1, -1, 0],
    expected_reorder: [1, 3],
  },
  {
