    expected_levels: [-1, -1, -1, 3],
    expected_reorder: [3],
  },
  {
    number: 64488,
    input: "\u{202E}\u{202C}\u{202B}\u{0627}",
    direction: None,
    expected_levels: [-1, -1, -1, 3],
    expected_reorder: [3],
  },
  {
    number: 64489,
    input: "\u{202E}\u{202C}\u{202B}\u{0627}",
    direction: Some(@bidi.Direction::RTL),
    expected_levels: [-1, -1, -1, 3],
    expected_reorder: [3],
  },
  {
