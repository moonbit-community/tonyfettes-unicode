    input: "\u{2066}\u{0009}\u{202A}\u{202B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 80989,
    input: "\u{2066}\u{0009}\u{202A}\u{202E}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 80990,
    input: "\u{2066}\u{0009}\u{202A}\u{202E}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 80991,
    input: "\u{2066}\u{0009}\u{202A}\u{202C}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 80992,
    input: "\u{2066}\u{0009}\u{202A}\u{202C}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 80993,
    input: "\u{2066}\u{0009}\u{202A}\u{200B}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 80994,
    input: "\u{2066}\u{0009}\u{202A}\u{200B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
    number: 80995,
    input: "\u{2066}\u{0009}\u{202D}\u{202A}",
    direction: None,
    expected_levels: [0, 0, -1, -1],
    expected_reorder: [0, 1],
  },
  {
