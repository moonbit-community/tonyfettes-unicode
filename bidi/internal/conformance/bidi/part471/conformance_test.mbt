    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235991,
    input: "\u{202C}\u{202C}\u{0660}\u{0061}",
    direction: None,
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235992,
    input: "\u{202C}\u{202C}\u{0660}\u{0061}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235993,
    input: "\u{202C}\u{202C}\u{0660}\u{0030}",
    direction: None,
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235994,
    input: "\u{202C}\u{202C}\u{0660}\u{0030}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235995,
    input: "\u{202C}\u{202C}\u{0660}\u{002B}",
    direction: None,
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235996,
    input: "\u{202C}\u{202C}\u{0660}\u{002B}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235997,
    input: "\u{202C}\u{202C}\u{0660}\u{0024}",
    direction: None,
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235998,
    input: "\u{202C}\u{202C}\u{0660}\u{0024}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235999,
    input: "\u{202C}\u{202C}\u{0660}\u{002C}",
    direction: None,
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
]

///|
test "BidiTest.txt part 471" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
