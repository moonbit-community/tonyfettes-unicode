    input: "\u{202E}\u{202A}\u{0030}\u{0009}",
    direction: None,
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235492,
    input: "\u{202E}\u{202A}\u{0030}\u{0009}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235493,
    input: "\u{202E}\u{202A}\u{0030}\u{0020}",
    direction: None,
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235494,
    input: "\u{202E}\u{202A}\u{0030}\u{0020}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235495,
    input: "\u{202E}\u{202A}\u{0030}\u{2066}",
    direction: None,
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235496,
    input: "\u{202E}\u{202A}\u{0030}\u{2066}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235497,
    input: "\u{202E}\u{202A}\u{0030}\u{2067}",
    direction: None,
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235498,
    input: "\u{202E}\u{202A}\u{0030}\u{2067}",
    direction: Some(@bidi.Direction::LTR),
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
  {
    number: 235499,
    input: "\u{202E}\u{202A}\u{0030}\u{2068}",
    direction: None,
    expected_levels: [-1, -1, 2, 0],
    expected_reorder: [2, 3],
  },
]

///|
test "BidiTest.txt part 470" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
