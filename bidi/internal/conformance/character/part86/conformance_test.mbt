    input: "\u{0061}\u{0029}\u{2680}\u{0028}\u{0062}\u{0029}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 43492,
    input: "\u{0061}\u{0029}\u{2680}\u{0028}\u{0062}\u{0029}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [2, 2, 2, 2, 2, 2],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 43493,
    input: "\u{0061}\u{0029}\u{2680}\u{0028}\u{0029}\u{0062}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 43494,
    input: "\u{0061}\u{0029}\u{2680}\u{0028}\u{0029}\u{0062}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [2, 2, 2, 2, 2, 2],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 43495,
    input: "\u{0061}\u{0029}\u{0028}\u{2680}\u{0062}\u{0029}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 43496,
    input: "\u{0061}\u{0029}\u{0028}\u{2680}\u{0062}\u{0029}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [2, 2, 2, 2, 2, 2],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 43497,
    input: "\u{0061}\u{0029}\u{0028}\u{2680}\u{0029}\u{0062}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 43498,
    input: "\u{0061}\u{0029}\u{0028}\u{2680}\u{0029}\u{0062}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [2, 2, 2, 2, 2, 2],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 43499,
    input: "\u{0061}\u{0029}\u{0028}\u{0029}\u{2680}\u{0062}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
]

///|
test "BidiCharacterTest.txt part 86" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    @debug.assert_eq(
      result.base_level,
      case.expected_base_level,
      msg="case \{case.number}: paragraph base level",
    )
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
