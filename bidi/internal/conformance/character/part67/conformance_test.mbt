    input: "\u{0028}\u{05D0}\u{0029}\u{0061}\u{0028}\u{0062}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 1, 1, 2, 2, 2],
    expected_reorder: [3, 4, 5, 2, 1, 0],
  },
  {
    number: 33989,
    input: "\u{0028}\u{0029}\u{05D0}\u{0061}\u{0028}\u{0062}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 1, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 33990,
    input: "\u{0028}\u{0029}\u{05D0}\u{0061}\u{0028}\u{0062}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 1, 1, 2, 2, 2],
    expected_reorder: [3, 4, 5, 2, 1, 0],
  },
  {
    number: 33991,
    input: "\u{05D0}\u{0028}\u{0061}\u{05D1}\u{0029}\u{0028}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [1, 0, 0, 1, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 33992,
    input: "\u{05D0}\u{0028}\u{0061}\u{05D1}\u{0029}\u{0028}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 1, 2, 1, 1, 1],
    expected_reorder: [5, 4, 3, 2, 1, 0],
  },
  {
    number: 33993,
    input: "\u{05D0}\u{0028}\u{0061}\u{0029}\u{05D1}\u{0028}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [1, 0, 0, 0, 1, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 33994,
    input: "\u{05D0}\u{0028}\u{0061}\u{0029}\u{05D1}\u{0028}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 1, 2, 1, 1, 1],
    expected_reorder: [5, 4, 3, 2, 1, 0],
  },
  {
    number: 33995,
    input: "\u{05D0}\u{0028}\u{0061}\u{0029}\u{0028}\u{05D1}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [1, 0, 0, 0, 0, 1],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 33996,
    input: "\u{05D0}\u{0028}\u{0061}\u{0029}\u{0028}\u{05D1}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 1, 2, 1, 1, 1],
    expected_reorder: [5, 4, 3, 2, 1, 0],
  },
  {
    number: 33997,
    input: "\u{05D0}\u{0028}\u{0029}\u{0061}\u{05D1}\u{0028}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [1, 0, 0, 0, 1, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
  {
    number: 33998,
    input: "\u{05D0}\u{0028}\u{0029}\u{0061}\u{05D1}\u{0028}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 1, 1, 2, 1, 1],
    expected_reorder: [5, 4, 3, 2, 1, 0],
  },
  {
    number: 33999,
    input: "\u{05D0}\u{0028}\u{0029}\u{0061}\u{0028}\u{05D1}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [1, 0, 0, 0, 0, 1],
    expected_reorder: [0, 1, 2, 3, 4, 5],
  },
]

///|
test "BidiCharacterTest.txt part 67" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    @debug.assert_eq(
      result.base_level,
      case.expected_base_level,
      msg="case \{case.number}: paragraph base level",
    )
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
