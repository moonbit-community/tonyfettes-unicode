    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 3986,
    input: "\u{0061}\u{0028}\u{0029}\u{0028}\u{2680}\u{0062}\u{2681}\u{0029}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [2, 2, 2, 2, 2, 2, 2, 2],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 3987,
    input: "\u{0061}\u{0028}\u{0029}\u{0028}\u{2680}\u{0062}\u{0029}\u{2681}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 3988,
    input: "\u{0061}\u{0028}\u{0029}\u{0028}\u{2680}\u{0062}\u{0029}\u{2681}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [2, 2, 2, 2, 2, 2, 2, 1],
    expected_reorder: [7, 0, 1, 2, 3, 4, 5, 6],
  },
  {
    number: 3989,
    input: "\u{0028}\u{0061}\u{2680}\u{0062}\u{2681}\u{0029}\u{0028}\u{0029}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 3990,
    input: "\u{0028}\u{0061}\u{2680}\u{0062}\u{2681}\u{0029}\u{0028}\u{0029}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 2, 2, 2, 1, 1, 1, 1],
    expected_reorder: [7, 6, 5, 4, 1, 2, 3, 0],
  },
  {
    number: 3991,
    input: "\u{0028}\u{0061}\u{2680}\u{0062}\u{0029}\u{2681}\u{0028}\u{0029}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 3992,
    input: "\u{0028}\u{0061}\u{2680}\u{0062}\u{0029}\u{2681}\u{0028}\u{0029}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 2, 2, 2, 1, 1, 1, 1],
    expected_reorder: [7, 6, 5, 4, 1, 2, 3, 0],
  },
  {
    number: 3993,
    input: "\u{0028}\u{0061}\u{2680}\u{0062}\u{0029}\u{0028}\u{2681}\u{0029}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 3994,
    input: "\u{0028}\u{0061}\u{2680}\u{0062}\u{0029}\u{0028}\u{2681}\u{0029}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 2, 2, 2, 1, 1, 1, 1],
    expected_reorder: [7, 6, 5, 4, 1, 2, 3, 0],
  },
  {
    number: 3995,
    input: "\u{0028}\u{0061}\u{2680}\u{0062}\u{0029}\u{0028}\u{0029}\u{2681}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 3996,
    input: "\u{0028}\u{0061}\u{2680}\u{0062}\u{0029}\u{0028}\u{0029}\u{2681}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 2, 2, 2, 1, 1, 1, 1],
    expected_reorder: [7, 6, 5, 4, 1, 2, 3, 0],
  },
  {
    number: 3997,
    input: "\u{0028}\u{0061}\u{2680}\u{0029}\u{0062}\u{2681}\u{0028}\u{0029}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    number: 3998,
    input: "\u{0028}\u{0061}\u{2680}\u{0029}\u{0062}\u{2681}\u{0028}\u{0029}",
    direction: Some(@bidi.Direction::RTL),
    expected_base_level: 1,
    expected_levels: [1, 2, 1, 1, 2, 1, 1, 1],
    expected_reorder: [7, 6, 5, 4, 3, 2, 1, 0],
  },
  {
    number: 3999,
    input: "\u{0028}\u{0061}\u{2680}\u{0029}\u{0062}\u{0028}\u{2681}\u{0029}",
    direction: Some(@bidi.Direction::LTR),
    expected_base_level: 0,
    expected_levels: [0, 0, 0, 0, 0, 0, 0, 0],
    expected_reorder: [0, 1, 2, 3, 4, 5, 6, 7],
  },
]

///|
test "BidiCharacterTest.txt part 7" {
  for case in test_cases {
    let direction = case.direction
    let result = @bidi.process(case.input, direction?)
    @debug.assert_eq(
      result.base_level,
      case.expected_base_level,
      msg="case \{case.number}: paragraph base level",
    )
    for index, expected_level in case.expected_levels {
      if expected_level >= 0 {
        @debug.assert_eq(
          result.levels[index],
          expected_level,
          msg="case \{case.number}: resolved level at index \{index}",
        )
      }
    }
    @debug.assert_eq(
      @bidi.reorder(result),
      case.expected_reorder,
      msg="case \{case.number}: visual reorder",
    )
  }
}
